generate_admin_ui() {
    # Upload/manage UI. Stored as a dotfile so it stays out of the sidebar/listing.
    # Written verbatim (quoted heredoc) then __MAX_DEPTH__ is substituted.
    cat > "$SRV_DIR/.admin.html" <<'ADMINEOF'
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Markdown Admin</title>
<style>
 body{font-family:-apple-system,system-ui,sans-serif;background:#0d1117;color:#c9d1d9;margin:0;padding:24px;max-width:900px;}
 h1{font-size:18px;} h2{font-size:13px;color:#8b949e;text-transform:uppercase;letter-spacing:1px;margin:0 0 12px;}
 a{color:#58a6ff;text-decoration:none;}
 button{background:#21262d;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;padding:6px 10px;cursor:pointer;font-size:12px;margin:2px;}
 button:hover{border-color:#58a6ff;} button.danger{color:#f85149;}
 input,textarea{background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;padding:8px;font-family:inherit;font-size:13px;}
 textarea{width:100%;height:260px;font-family:monospace;box-sizing:border-box;}
 input[type=text]{width:55%;}
 table{border-collapse:collapse;width:100%;} td,th{text-align:left;padding:6px 8px;border-bottom:1px solid #21262d;font-size:13px;}
 .msg{padding:8px 12px;border-radius:6px;margin:12px 0;display:none;}
 .ok{background:#1a3a1a;color:#3fb950;} .err{background:#3a1a1a;color:#f85149;}
 .card{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:16px;margin-bottom:16px;}
</style></head><body>
<h1>&#128221; Markdown Server &mdash; Admin</h1>
<p><a href="/">&larr; back to site</a> &nbsp;|&nbsp; max folder depth: <b>__MAX_DEPTH__</b></p>
<div id="msg" class="msg"></div>

<div class="card"><h2>Upload files</h2>
 <input type="file" id="up" multiple>
 <input type="text" id="upDir" placeholder="target folder (blank = root)">
 <button onclick="uploadFiles()">Upload</button></div>

<div class="card"><h2>New / edit markdown</h2>
 <input type="text" id="path" placeholder="path e.g. notes/page.md"><br><br>
 <textarea id="content" placeholder="# Markdown content..."></textarea><br>
 <button onclick="saveFile()">Save</button>
 <button onclick="document.getElementById('content').value='';document.getElementById('path').value='';">Clear</button></div>

<div class="card"><h2>New folder</h2>
 <input type="text" id="newdir" placeholder="folder path e.g. notes/sub">
 <button onclick="makeDir()">Create folder</button></div>

<div class="card"><h2>Files <button onclick="loadFiles()">&#8635; refresh</button></h2>
 <table id="files"><tbody></tbody></table></div>

<script>
const MAX_DEPTH = parseInt("__MAX_DEPTH__", 10);
function show(t, ok){ const m=document.getElementById('msg'); m.textContent=t; m.className='msg '+(ok?'ok':'err'); m.style.display='block'; setTimeout(()=>m.style.display='none', 5000); }
function davUrl(p){ return '/dav/' + p.replace(/^\/+/, ''); }
function folderDepth(p){ return p.replace(/^\/+|\/+$/g,'').split('/').length; }
async function loadFiles(){
  try{
    const d = await (await fetch('/api/files.json')).json();
    const tb = document.querySelector('#files tbody'); tb.innerHTML='';
    if(d.truncatedDepth){ const tr=tb.insertRow(); tr.innerHTML='<td colspan="3" style="color:#d29922">&#9888; some files are nested beyond '+d.maxDepth+' levels and are not listed</td>'; }
    d.files.forEach(f=>{
      const tr=tb.insertRow();
      tr.innerHTML = '<td><a href="'+f.path+'">'+f.path+'</a></td>'+
        '<td><button onclick="editFile(\''+f.path+'\')">edit</button></td>'+
        '<td><button class="danger" onclick="delFile(\''+f.path+'\')">delete</button></td>';
    });
  }catch(e){ show('Failed to load file list: '+e, false); }
}
async function uploadFiles(){
  const files = document.getElementById('up').files;
  let dir = document.getElementById('upDir').value.trim().replace(/^\/+|\/+$/g,'');
  if(!files.length){ show('Choose file(s) first', false); return; }
  if(dir && folderDepth(dir) > MAX_DEPTH){ show('Folder too deep (max '+MAX_DEPTH+' levels)', false); return; }
  for(const f of files){
    const p = (dir?dir+'/':'') + f.name;
    const r = await fetch(davUrl(p), {method:'PUT', body: await f.arrayBuffer()});
    if(!r.ok){ show('Upload failed: '+f.name+' ('+r.status+')', false); return; }
  }
  show('Uploaded '+files.length+' file(s)', true); loadFiles();
}
async function saveFile(){
  let p = document.getElementById('path').value.trim().replace(/^\/+/, '');
  if(!p){ show('Enter a path', false); return; }
  if(folderDepth(p) - 1 > MAX_DEPTH){ show('Path too deep (max '+MAX_DEPTH+' folder levels)', false); return; }
  const r = await fetch(davUrl(p), {method:'PUT', body: document.getElementById('content').value});
  if(r.ok){ show('Saved '+p, true); loadFiles(); } else { show('Save failed ('+r.status+')', false); }
}
async function editFile(path){
  const t = await (await fetch('/raw'+path)).text();
  document.getElementById('path').value = path.replace(/^\/+/, '');
  document.getElementById('content').value = t;
  window.scrollTo(0,0);
}
async function delFile(path){
  if(!confirm('Delete '+path+'?')) return;
  const r = await fetch(davUrl(path), {method:'DELETE'});
  if(r.ok){ show('Deleted '+path, true); loadFiles(); } else { show('Delete failed ('+r.status+')', false); }
}
async function makeDir(){
  let p = document.getElementById('newdir').value.trim().replace(/^\/+|\/+$/g,'');
  if(!p){ show('Enter a folder path', false); return; }
  if(folderDepth(p) > MAX_DEPTH){ show('Folder too deep — max '+MAX_DEPTH+' levels allowed', false); return; }
  const r = await fetch(davUrl(p)+'/', {method:'MKCOL'});
  if(r.ok){ show('Created folder '+p, true); loadFiles(); } else { show('Mkdir failed ('+r.status+') — parent folders must exist first', false); }
}
loadFiles();
</script></body></html>
ADMINEOF
    sed -i "s/__MAX_DEPTH__/$MAX_FOLDER_DEPTH/g" "$SRV_DIR/.admin.html"
}

