#!/bin/bash
#
# install-md — Markdown Server installer (Chubtoad5)
#
# A Caddy-in-Docker static Markdown site with a folder-hierarchy sidebar.
# Conforms to the Chubtoad5 tooling conventions: runtime env-var overrides,
# distro detection, root requirement, JIT dependency fetch, and a per-run log.
#
# Phase 1 (this revision): online install only. Air-gap save/offline, the
# custom WebDAV image, the agent API, and the upload UI arrive in later phases.

set -euo pipefail

SCRIPT_VERSION="1.1.0"
IPP_URL="https://github.com/Chubtoad5/images-pull-push/raw/refs/heads/main/image_pull_push.sh"

### ---- USER DEFINED VARIABLES (all runtime-overridable: sudo VAR=value ./install-md) ----
BASE_DIR="${BASE_DIR:-/opt/caddy-markdown}"           # Install and data directory
SRV_DIR="${SRV_DIR:-$BASE_DIR/srv}"                   # Markdown content directory
MGMT_IP="${MGMT_IP:-$(hostname -I | awk '{print $1}')}"  # Bind IP address
FQDN="${TLS_FQDN:-${FQDN:-md.$(hostname -f 2>/dev/null || hostname)}}"  # FQDN (TLS_FQDN alias accepted)
TCP_PORT="${TCP_PORT:-80}"                            # Listen port (use 443+ with TLS)
TLS_MODE="${TLS_MODE:-none}"                          # none | internal (self-signed) | auto (letsencrypt)
BROWSER_TITLE="${BROWSER_TITLE:-Markdown Server}"     # Browser tab title
CADDY_VERSION="${CADDY_VERSION:-latest}"              # Caddy image tag

LOG_FILE="$(pwd)/md-install.log"

_err() { echo "ERROR: install-md failed at line $1 (exit $2). See ${LOG_FILE} for details." >&2; }
trap '_err "$LINENO" "$?"' ERR

usage() {
    cat <<EOF
install-md — Markdown Server installer (Chubtoad5) v$SCRIPT_VERSION

Usage: sudo [VAR=value ...] ./install-md [command]

Commands:
  install     Install or refresh the Markdown Server (default if omitted)
  uninstall   Stop and remove the stack (backs up content first; MD_PURGE=true to skip)
  status      Show container status and an HTTP health probe
  version     Print installer and Caddy version info
  help        Show this help

Environment variables (override at runtime, e.g. sudo TCP_PORT=8080 ./install-md):
  BASE_DIR        Install/data directory          (default: /opt/caddy-markdown)
  SRV_DIR         Markdown content directory       (default: \$BASE_DIR/srv)
  MGMT_IP         Bind IP address                  (default: first host IP)
  FQDN            Server FQDN (TLS_FQDN alias)      (default: md.\$(hostname -f))
  TCP_PORT        Listen port                      (default: 80)
  TLS_MODE        none | internal | auto           (default: none)
  BROWSER_TITLE   Browser tab title                (default: Markdown Server)
  CADDY_VERSION   Caddy image tag                  (default: latest)
  MD_RESET        true = wipe content on install (backup still taken)   (default: false)
  MD_PURGE        true = skip content backup on uninstall               (default: false)
EOF
}

show_version() {
    echo "install-md (markdown-server) v$SCRIPT_VERSION"
    echo "configured CADDY_VERSION: $CADDY_VERSION"
}

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "This script must be run as root." >&2
        exit 1
    fi
}

detect_distro() {
    if [[ ! -r /etc/os-release ]]; then
        echo "Error: /etc/os-release not found; cannot detect OS." >&2
        exit 1
    fi
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}" in
        ubuntu|debian|rhel|centos|rocky|almalinux|fedora|sles|opensuse-leap)
            echo "  Detected supported OS: ${ID} ${VERSION_ID:-}" ;;
        *)
            echo "Error: Unknown or unsupported OS '${ID:-unknown}'." >&2
            exit 1 ;;
    esac
}

port_in_use() {
    local p="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnH "( sport = :$p )" 2>/dev/null | grep -q .
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    else
        return 1  # no probe available; assume free
    fi
}

ensure_docker() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "  Docker and compose plugin present."
        return 0
    fi
    echo "  Docker or compose plugin missing — installing via images-pull-push (conventions §9)..."
    mkdir -p "$BASE_DIR/utilities"
    if [[ ! -x "$BASE_DIR/utilities/image_pull_push.sh" ]]; then
        curl -sfL "$IPP_URL" -o "$BASE_DIR/utilities/image_pull_push.sh"
        chmod +x "$BASE_DIR/utilities/image_pull_push.sh"
    fi
    ( cd "$BASE_DIR/utilities" && ./image_pull_push.sh docker )
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: Docker installation did not complete successfully." >&2
        exit 1
    fi
}

generate_caddyfile() {
    if [[ "$TLS_MODE" == "none" ]]; then
        echo "  Configuring HTTP on port $TCP_PORT"
        cat > "$BASE_DIR/Caddyfile" <<EOF
http://$FQDN:$TCP_PORT http://$MGMT_IP:$TCP_PORT {
EOF
    else
        echo "  Configuring HTTPS on port $TCP_PORT (TLS_MODE=$TLS_MODE)"
        cat > "$BASE_DIR/Caddyfile" <<EOF
{
  default_sni $MGMT_IP
}
https://$FQDN:$TCP_PORT https://$MGMT_IP:$TCP_PORT {
EOF
    fi
    if [[ "$TLS_MODE" == "internal" ]]; then
        cat >> "$BASE_DIR/Caddyfile" <<'EOF'
    tls internal
EOF
    fi
    cat >> "$BASE_DIR/Caddyfile" <<'EOF'
    root * /srv
    templates
    file_server

    @markdown_site path / *.md
    rewrite @markdown_site /layout.html
}
EOF
}

generate_layout() {
    cat > "$SRV_DIR/layout.html" <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>$BROWSER_TITLE</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.2.0/github-markdown-dark.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css">
    <style>
        :root {
            --sidebar-bg: #0d1117;
            --content-bg: #161b22;
            --code-bg: #0d1117;
            --text-main: #c9d1d9;
            --accent: #58a6ff;
            --sidebar-border: #30363d;
            --link-color: #8b949e;
            --sidebar-width: 195px;
        }

        body {
            display: flex; margin: 0; height: 100vh; overflow: hidden;
            font-family: -apple-system, system-ui, sans-serif;
            background-color: var(--content-bg); color: var(--text-main);
        }

        nav {
            width: var(--sidebar-width); min-width: 120px; max-width: 50vw;
            box-sizing: border-box; background-color: var(--sidebar-bg);
            border-right: 1px solid var(--sidebar-border);
            padding: 25px 15px; overflow-y: auto; flex-shrink: 0;
        }

        nav h3 { font-size: 10px; color: #8b949e; text-transform: uppercase; margin-bottom: 15px; letter-spacing: 1px; }
        nav ul { list-style: none; padding: 0; margin: 0; }
        nav li { margin-bottom: 4px; }

        nav a {
            display: block; padding: 10px 12px; font-size: 13px;
            color: var(--link-color) !important; text-decoration: none !important;
            border-radius: 6px; white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis; min-height: 1.2em;
        }

        nav a:hover { background-color: #21262d; color: var(--accent) !important; }
        nav a.active { background-color: #1f6feb; color: #ffffff !important; font-weight: 600; }

        /* Folder styles */
        .folder-toggle {
            display: flex; align-items: center; padding: 10px 12px; font-size: 13px;
            color: var(--link-color); cursor: pointer; border-radius: 6px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            user-select: none; font-weight: 600;
        }
        .folder-toggle:hover { background-color: #21262d; color: var(--accent); }
        .folder-toggle::before {
            content: '\25B6'; display: inline-block; margin-right: 8px; font-size: 9px;
            transition: transform 0.2s ease; flex-shrink: 0;
        }
        .folder.expanded > .folder-toggle::before { transform: rotate(90deg); }
        .folder-contents { display: none; padding-left: 12px; }
        .folder.expanded > .folder-contents { display: block; }

        /* Resize handle */
        .resize-handle {
            width: 5px; cursor: col-resize; background-color: transparent;
            flex-shrink: 0; transition: background-color 0.15s;
        }
        .resize-handle:hover, .resize-handle.active { background-color: var(--accent); }

        main { flex-grow: 1; overflow-y: auto; background-color: var(--content-bg); }
        .markdown-body { box-sizing: border-box; width: 100%; max-width: 100%; padding: 50px; background-color: transparent !important; }

        .markdown-body pre { position: relative; background-color: var(--code-bg) !important; border: 1px solid #30363d !important; border-radius: 8px; padding: 16px; }

        .copy-code-button { position: absolute; top: 10px; right: 10px; padding: 4px 8px; background-color: #21262d; color: #8b949e; border: 1px solid #30363d; border-radius: 6px; font-size: 11px; cursor: pointer; opacity: 0; transition: opacity 0.2s; z-index: 10; }
        pre:hover .copy-code-button { opacity: 1; }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--sidebar-bg); }
        ::-webkit-scrollbar-thumb { background: #30363d; border-radius: 10px; }
    </style>
</head>
<body>

<nav id="sidebar">
  <h3>Navigation</h3>
  <ul>
    <li>
      <a href="/"
         class="{{ if or (eq .OriginalReq.URL.Path "/") (eq .OriginalReq.URL.Path "") }}active{{ end }}">
        Home
      </a>
    </li>

    {{/* 1) Collect root-level markdown files */}}
    {{ \$rootFiles := list }}
    {{ range listFiles "/" }}
      {{ if and (hasSuffix ".md" .) (ne . "index.md") (ne . "layout.html") }}
        {{ \$rootFiles = append \$rootFiles . }}
      {{ end }}
    {{ end }}

    {{/* 2) Render sorted root-level files */}}
    {{ range sortAlpha \$rootFiles }}
      <li>
        <a href="/{{ . }}"
           class="{{ if eq $.OriginalReq.URL.Path (printf "/%s" .) }}active{{ end }}">
          {{ . | trimSuffix ".md" | replace "-" " " }}
        </a>
      </li>
    {{ end }}

    {{/* 3) Collect subdirectories (non .md, non .html, non hidden entries) */}}
    {{ \$dirs := list }}
    {{ range listFiles "/" }}
      {{ if and (not (hasSuffix ".md" .)) (not (hasSuffix ".html" .)) (not (hasPrefix "." .)) }}
        {{ \$dirs = append \$dirs . }}
      {{ end }}
    {{ end }}

    {{/* 4) Render sorted directories with their markdown files */}}
    {{ range sortAlpha \$dirs }}
      {{ \$dirName := . }}
      {{ \$dirFiles := list }}
      {{ range listFiles (printf "/%s" \$dirName) }}
        {{ if hasSuffix ".md" . }}
          {{ \$dirFiles = append \$dirFiles . }}
        {{ end }}
      {{ end }}
      {{ if \$dirFiles }}
        {{ \$hasActive := false }}
        {{ range sortAlpha \$dirFiles }}
          {{ if eq $.OriginalReq.URL.Path (printf "/%s/%s" \$dirName .) }}
            {{ \$hasActive = true }}
          {{ end }}
        {{ end }}
        <li class="folder{{ if \$hasActive }} expanded{{ end }}">
          <div class="folder-toggle">{{ \$dirName | replace "-" " " }}</div>
          <ul class="folder-contents">
            {{ range sortAlpha \$dirFiles }}
              <li>
                <a href="/{{ \$dirName }}/{{ . }}"
                   class="{{ if eq $.OriginalReq.URL.Path (printf "/%s/%s" \$dirName .) }}active{{ end }}">
                  {{ . | trimSuffix ".md" | replace "-" " " }}
                </a>
              </li>
            {{ end }}
          </ul>
        </li>
      {{ end }}
    {{ end }}

  </ul>
</nav>

<div class="resize-handle" id="resizeHandle"></div>

<main>
    <article class="markdown-body">
        {{\$req := .OriginalReq.URL.Path}}
        {{if or (eq \$req "/") (eq \$req "")}}
            {{markdown (readFile "index.md")}}
        {{else}}
            {{markdown (readFile \$req)}}
        {{end}}
    </article>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        hljs.highlightAll();

        // Copy code button
        document.querySelectorAll('pre').forEach((codeBlock) => {
            const button = document.createElement('button');
            button.className = 'copy-code-button';
            button.innerText = 'Copy';
            button.addEventListener('click', () => {
                const text = codeBlock.querySelector('code').innerText;
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    button.innerText = 'Copied!';
                } catch (err) { button.innerText = 'Error'; }
                document.body.removeChild(textArea);
                setTimeout(() => { button.innerText = 'Copy'; }, 2000);
            });
            codeBlock.appendChild(button);
        });

        // Folder expand/collapse toggle
        document.querySelectorAll('.folder-toggle').forEach((toggle) => {
            toggle.addEventListener('click', () => {
                toggle.parentElement.classList.toggle('expanded');
            });
        });

        // Sidebar resize with mouse drag
        const sidebar = document.getElementById('sidebar');
        const handle = document.getElementById('resizeHandle');
        let isResizing = false;

        // Restore saved sidebar width
        const savedWidth = localStorage.getItem('mdSidebarWidth');
        if (savedWidth) {
            const w = parseInt(savedWidth, 10);
            if (w >= 120 && w <= window.innerWidth * 0.5) {
                sidebar.style.width = w + 'px';
            }
        }

        handle.addEventListener('mousedown', (e) => {
            isResizing = true;
            handle.classList.add('active');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isResizing) return;
            const newWidth = e.clientX;
            if (newWidth >= 120 && newWidth <= window.innerWidth * 0.5) {
                sidebar.style.width = newWidth + 'px';
            }
        });

        document.addEventListener('mouseup', () => {
            if (isResizing) {
                isResizing = false;
                handle.classList.remove('active');
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                localStorage.setItem('mdSidebarWidth', sidebar.offsetWidth);
            }
        });
    });
</script>
</body>
</html>
EOF
}

