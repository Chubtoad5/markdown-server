    '<div style="display:flex;align-items:center;gap:6px;padding:3px 0;border-bottom:1px solid #21262d">'
    +'<button onclick="moveOrder('+i+',-1)"'+(i===0?' disabled':'')+'>&#9650;</button>'
    +'<button onclick="moveOrder('+i+',1)"'+(i===orderItems.length-1?' disabled':'')+'>&#9660;</button>'
    +'<span>'+(it.isDir?'&#128193; ':'&#128196; ')+escapeHtml(it.name)+'</span></div>'
  ).join('');
  saveBtn.style.display = 'inline-block';
}
function moveOrder(i, d){
  const j = i + d;
  if(j < 0 || j >= orderItems.length) return;
  const t = orderItems[i]; orderItems[i] = orderItems[j]; orderItems[j] = t;
  renderOrder();
}
async function saveOrder(){
  if(!orderItems.length){ show('Nothing to save', false); return; }
  const body = orderItems.map(it=>it.name).join('\n') + '\n';
  const path = (orderFolder ? orderFolder+'/' : '') + '.order';
  const r = await fetch(davUrl(path), {method:'PUT', body});
  if(r.ok){ show('Saved order for '+(orderFolder||'(root)')+' — reload the site to see it', true); }
  else { show('Save order failed ('+r.status+')', false); }
}

