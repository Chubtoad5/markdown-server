<script>
const MAX_DEPTH = parseInt("__MAX_DEPTH__", 10);
function show(t, ok){ const m=document.getElementById('msg'); m.textContent=t; m.className='msg '+(ok?'ok':'err'); m.style.display='block'; setTimeout(()=>m.style.display='none', 5000); }
function davUrl(p){ return '/dav/' + p.replace(/^\/+/, ''); }
function folderDepth(p){ return p.replace(/^\/+|\/+$/g,'').split('/').length; }
async function loadFiles(){
  try{
    const d = await (await fetch('/api/files.json')).json();
    const tb = document.querySelector('#files tbody'); tb.innerHTML='';
    if(d.truncatedDepth){ const tr=tb.insertRow(); tr.innerHTML='<td colspan="3" style="color:#d29922">&#9888; some files are nested beyond '+d.maxDepth+' levels and are not listed</td>'; }
