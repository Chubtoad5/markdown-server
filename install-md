# ---- Admin login (AUTH_MODE=basic) ----
# The stored login is $BASE_DIR/.auth-hash, root only: the user, Caddy's hash of the password, and a fingerprint that
# ties the hash to its password, as SeaweedFS's installer does. A re-run with the same password keeps the hash, so the
# Caddyfile doesn't change and Caddy isn't restarted (spec 21, Q5). A re-run with no MD_ADMIN_PASSWORD keeps the
# stored login (M3).
auth_file() { echo "$BASE_DIR/.auth-hash"; }

# auth_fingerprint <hash> <password>: the sha256 of "hash:password". The password reaches sha256sum on a pipe, never in
# its arguments. It's a fast hash, which is why .auth-hash is 0600.
auth_fingerprint() { printf '%s' "$1:$2" | sha256sum | awk '{print $1}'; }

# is_admin_hash <hash>: a hash Caddy's basic_auth takes: bcrypt, or argon2id (Caddy 2.11 and later).
is_admin_hash() { [[ "$1" == '$2'[aby]'$'?* || "$1" == '$argon2id$'?* ]]; }

# read_stored_login: STORED_USER, STORED_HASH and STORED_FP from .auth-hash. An install by v1.6.1 or earlier kept no
# .auth-hash, so its login comes from its Caddyfile's basic_auth block, with no fingerprint. STORED_FROM names the
# file. Returns 1 when there's no stored login, and 2 when there's one that can't be read.
read_stored_login() {
    local f line block_re='^[[:space:]]*basic_auth( (bcrypt|argon2id))? [{]$'
    STORED_USER="" STORED_HASH="" STORED_FP="" STORED_FROM=""
    f=$(auth_file)
    if [[ -f "$f" ]]; then
        STORED_USER=$(sed -n 's/^user=//p' "$f")
        STORED_HASH=$(sed -n 's/^hash=//p' "$f")
        STORED_FP=$(sed -n 's/^fingerprint=//p' "$f")
    elif [[ -f "$BASE_DIR/Caddyfile" ]] && grep -qE "$block_re" "$BASE_DIR/Caddyfile"; then
        f="$BASE_DIR/Caddyfile"
        line=$(awk -v re="$block_re" '$0 ~ re { getline; print; exit }' "$f")
        read -r STORED_USER STORED_HASH _ <<< "$line"
    else
        return 1
    fi
    STORED_FROM=$f
    if [[ -z "$STORED_USER" ]] || ! is_admin_hash "$STORED_HASH"; then
        return 2
    fi
}

# check_admin_login: the admin login's checks, all before anything is stopped or changed (spec 21, rule 7), each
# naming its variable and never showing a value. Then which login this install writes: MD_ADMIN_PASSWORD when it's
# set; the stored login when it isn't (M3); changeme on a first install. A password that matches the stored
# fingerprint keeps the stored hash (Q5); any other is hashed later, by hash_admin_password, once the image is there.
check_admin_login() {
    [[ "$ENABLE_WEBDAV" == "true" && "$AUTH_MODE" == "basic" ]] || return 0
    local stored=0 bad=0
    # Spelled out rather than A-Z, which some locales stretch to other letters
    local user_re='^[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._@+-]+$'
    read_stored_login || stored=$?
    [[ -n "$MD_ADMIN_USER" ]] || MD_ADMIN_USER=${STORED_USER:-admin}
    if ! [[ "$MD_ADMIN_USER" =~ $user_re ]]; then
        echo "Error: MD_ADMIN_USER can only have letters, digits and . _ @ + - (the Caddyfile takes the name as written)." >&2
        bad=1
    fi
    if [[ -n "$ADMIN_PASSWORD_GIVEN" ]]; then
        if [[ -z "$MD_ADMIN_PASSWORD" ]]; then
            echo "Error: MD_ADMIN_PASSWORD is set but empty. Unset it to keep the current password, or set a new one." >&2
            bad=1
        elif [[ "$MD_ADMIN_PASSWORD" == *[[:cntrl:]]* ]]; then
            echo "Error: MD_ADMIN_PASSWORD can't contain a control character, such as a tab or a newline." >&2
            bad=1
        elif (( ${#MD_ADMIN_PASSWORD} > 128 )); then
            echo "Error: MD_ADMIN_PASSWORD can't be longer than 128 characters." >&2
            bad=1
        fi
    elif [[ $stored -eq 2 ]]; then
        echo "Error: the admin login the last install stored in $STORED_FROM can't be read. Set MD_ADMIN_PASSWORD to set it again." >&2
        bad=1
    fi
    [[ $bad -eq 0 ]] || exit 1

    if [[ -z "$ADMIN_PASSWORD_GIVEN" && $stored -eq 0 ]]; then
        ADMIN_HASH=$STORED_HASH ADMIN_FINGERPRINT=$STORED_FP ADMIN_PASSWORD_SOURCE=kept
        if [[ -n "$STORED_FP" && "$(auth_fingerprint "$STORED_HASH" changeme)" == "$STORED_FP" ]]; then
            ADMIN_PASSWORD_SOURCE=default
        fi
        return 0
    fi
    [[ -n "$ADMIN_PASSWORD_GIVEN" ]] || MD_ADMIN_PASSWORD=changeme
    ADMIN_PASSWORD_SOURCE=given
    [[ "$MD_ADMIN_PASSWORD" != changeme ]] || ADMIN_PASSWORD_SOURCE=default
    if [[ $stored -eq 0 && -n "$STORED_FP" && "$(auth_fingerprint "$STORED_HASH" "$MD_ADMIN_PASSWORD")" == "$STORED_FP" ]]; then
        ADMIN_HASH=$STORED_HASH ADMIN_FINGERPRINT=$STORED_FP
    fi
}

# hash_admin_password: ADMIN_HASH from the runtime image's Caddy, argon2id, with the password on stdin (spec 21, rules
# 2 and 4), never on the command line, where ps shows it to every local account. Caddy reads one line and drops the
# newline. A Caddy older than 2.11 (an old bundle or registry image, or an older CADDY_VERSION) has no argon2id, so it
# hashes with bcrypt, as before, which takes up to 72 bytes.
hash_admin_password() {
    local img out help
    img="$(runtime_image)"
    out=$(printf '%s\n' "$MD_ADMIN_PASSWORD" | docker run --rm -i "$img" caddy hash-password --algorithm argon2id) || out=""
    if [[ "$out" != '$argon2id$'?* ]]; then
        help=$(docker run --rm "$img" caddy hash-password --help 2>&1 || true)
        if [[ "$help" == *argon2id* ]]; then
            echo "Error: the Caddy in $img couldn't hash the admin password." >&2
            exit 1
        fi
        if (( $(printf '%s' "$MD_ADMIN_PASSWORD" | wc -c) > 72 )); then
            echo "Error: MD_ADMIN_PASSWORD is over 72 bytes, which needs argon2id, and the Caddy in $img is older than 2.11 and has none." >&2
            echo "  Use a newer Caddy (for example CADDY_VERSION=2.11.3), or a password of 72 bytes or fewer." >&2
            exit 1
        fi
        echo "  NOTE: the Caddy in $img is older than 2.11 and has no argon2id, so the admin password is hashed with bcrypt."
        out=$(printf '%s\n' "$MD_ADMIN_PASSWORD" | docker run --rm -i "$img" caddy hash-password) || out=""
        if [[ "$out" != '$2'[aby]'$'?* ]]; then
            echo "Error: the Caddy in $img couldn't hash the admin password." >&2
            exit 1
        fi
    fi
    ADMIN_HASH=$out
    ADMIN_FINGERPRINT=$(auth_fingerprint "$ADMIN_HASH" "$MD_ADMIN_PASSWORD")
}

# save_admin_login: .auth-hash, root only (0600), written whole, then moved into place.
save_admin_login() {
    local f
    f=$(auth_file)
    rm -f "$f.new"
    ( umask 077; printf 'user=%s\nhash=%s\nfingerprint=%s\n' "$MD_ADMIN_USER" "$ADMIN_HASH" "$ADMIN_FINGERPRINT" > "$f.new" )
    chmod 600 "$f.new"
    mv -f "$f.new" "$f"
}

auth_block() {
    # Emits the auth directive for a write handle, per AUTH_MODE. Indented 8 spaces. The user name passed
    # check_admin_login's rule, so it's one plain Caddyfile token. A bcrypt hash kept from an older install keeps
    # today's line, so the Caddyfile doesn't change and Caddy isn't restarted for it.
    case "$AUTH_MODE" in
        basic)
            if [[ "$ADMIN_HASH" == '$argon2id$'* ]]; then
                echo "        basic_auth argon2id {"
            else
                echo "        basic_auth {"
            fi
            echo "            $MD_ADMIN_USER $ADMIN_HASH"
            echo "        }"
            ;;
        forward)
            echo "        forward_auth $FORWARD_AUTH_URL {"
            echo "            uri /outpost.goauthentik.io/auth/caddy"
            echo "            copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email"
            echo "        }"
            ;;
        none|*)
            echo "        # AUTH_MODE=none: write access is UNAUTHENTICATED (anyone can write/delete)"
            ;;
    esac
}

emit_write_handles() {
    echo
    echo "    # Upload / manage UI (auth-gated)."
    echo "    handle /admin* {"
    auth_block
    echo "        rewrite * /.admin.html"
    echo "        file_server"
    echo "    }"
    echo
    echo "    # WebDAV write API for the UI and AI agents (auth-gated)."
    echo "    handle /dav/* {"
    auth_block
    echo "        uri strip_prefix /dav"
    echo "        webdav"
    echo "    }"
}

generate_caddyfile() {
    local cfile="$BASE_DIR/Caddyfile"
    : > "$cfile"

    # Global options block — only emitted when something needs it.
    if [[ "$ENABLE_WEBDAV" == "true" || "$TLS_MODE" == "internal" ]]; then
        {
            echo "{"
            [[ "$ENABLE_WEBDAV" == "true" ]] && echo "    order webdav before file_server"
            [[ "$TLS_MODE" == "internal" ]] && echo "    default_sni $MGMT_IP"
            echo "}"
        } >> "$cfile"
    fi

    local site
    if [[ "$TLS_MODE" == "none" ]]; then
        echo "  Configuring HTTP on port $TCP_PORT (any host — IP, hostname, or FQDN all work)"
        site=":$TCP_PORT"
    elif [[ "$TLS_MODE" == "internal" ]]; then
        echo "  Configuring HTTPS (self-signed) on port $TCP_PORT for IP $MGMT_IP and FQDN $FQDN"
        site="https://$MGMT_IP:$TCP_PORT https://$FQDN:$TCP_PORT"
    else
        echo "  Configuring HTTPS (Let's Encrypt) on port $TCP_PORT for FQDN $FQDN"
        echo "  NOTE: TLS_MODE=auto needs a public, resolvable FQDN; IP-only access is not possible with Let's Encrypt."
        site="$FQDN:$TCP_PORT"
    fi

    {
        echo "$site {"
        [[ "$TLS_MODE" == "internal" ]] && echo "    tls internal"
        cat <<'ROUTES_HEAD'
    root * /srv

    # Vendored CSS/JS, served locally so the page renders fully offline.
    handle /_assets/* {
        root * /assets
        uri strip_prefix /_assets
        file_server
    }

    # Raw markdown for AI agents (no HTML layout).
    handle /raw/* {
        uri strip_prefix /raw
        header Content-Type "text/markdown; charset=utf-8"
        file_server
    }

    # JSON index of every markdown file (live, recursive).
    # templates only renders allowed MIME types, and the header sets
    # application/json before templates runs — so add it to the mime list.
    handle /api/files.json {
        rewrite * /.files-index.html
        header Content-Type "application/json; charset=utf-8"
        templates {
            mime application/json text/html
        }
        file_server
    }

    # Discovery hint for AI agents.
    handle /llms.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond `# Markdown Server
This site renders Markdown as HTML. For raw/source access (AI agents):
- Raw file:   GET /raw/<path>.md     (Content-Type: text/markdown)
- Or append:  ?raw=1 to any .md URL
- File index: GET /api/files.json     (JSON list of every .md path)
- Write API:  WebDAV under /dav/ (PUT/DELETE/MKCOL/MOVE) when enabled
` 200
    }

    # Content negotiation: ?raw=1 returns raw markdown without the layout.
    @rawquery {
        path *.md
        query raw=1
    }
    handle @rawquery {
        header Content-Type "text/markdown; charset=utf-8"
        file_server
    }
ROUTES_HEAD

        # Write path: WebDAV + admin UI (auth-gated), only when enabled.
        if [[ "$ENABLE_WEBDAV" == "true" ]]; then
            emit_write_handles
        fi

        cat <<'ROUTES_TAIL'

    # Rendered Markdown site (folder sidebar + GitHub theme).
    handle {
        templates
        @markdown_site path / *.md
        rewrite @markdown_site /layout.html
        file_server
    }
}
ROUTES_TAIL
    } >> "$cfile"
}

