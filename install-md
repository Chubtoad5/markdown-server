<script src="/_assets/highlight.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        hljs.highlightAll();

        // Copy code button
        document.querySelectorAll('pre').forEach((codeBlock) => {
            const button = document.createElement('button');
            button.className = 'copy-code-button';
            button.innerText = 'Copy';
            button.addEventListener('click', () => {
                const text = codeBlock.querySelector('code').innerText;
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    button.innerText = 'Copied!';
                } catch (err) { button.innerText = 'Error'; }
                document.body.removeChild(textArea);
                setTimeout(() => { button.innerText = 'Copy'; }, 2000);
            });
            codeBlock.appendChild(button);
        });

        // Media: auto-embed video files, audio files, and YouTube links written as plain
        // markdown (![](clip.mp4) / ![](song.mp3) / [t](https://youtu.be/ID) on their own
        // line), and make real images responsive + click-to-enlarge. Raw <video>/<iframe>
        // authored directly in markdown still pass through untouched. Scoped to the article.
        // Build a single in-page lightbox modal and return an open(src, alt) function.
        function setupLightbox(){
            const modal = document.createElement('div');
            modal.className = 'img-modal';
            modal.setAttribute('aria-hidden', 'true');
            const big = document.createElement('img');
            big.className = 'img-modal-content';
            big.alt = '';
            const close = document.createElement('span');
            close.className = 'img-modal-close';
            close.setAttribute('aria-label', 'Close');
            close.innerHTML = '&times;';
            modal.appendChild(close);
            modal.appendChild(big);
            document.body.appendChild(modal);
            function hide(){ modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); big.setAttribute('src', ''); }
            modal.addEventListener('click', hide);   // click anywhere (image / backdrop / close) dismisses
            document.addEventListener('keydown', function(e){ if(e.key === 'Escape') hide(); });
            return function(src, alt){
                big.setAttribute('src', src);
                big.setAttribute('alt', alt || '');
                modal.classList.add('open');
                modal.setAttribute('aria-hidden', 'false');
            };
        }

        (function enhanceMedia(){
            const root = document.querySelector('main .markdown-body');
            if(!root) return;
            const VIDEO_EXT = ['mp4','webm','ogv','mov','m4v','mkv'];
            const AUDIO_EXT = ['mp3','wav','m4a','flac','aac','ogg','oga'];
            const openLightbox = setupLightbox();

            function ytId(u){
                try{
                    const m = u.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/))([A-Za-z0-9_-]{6,})/);
                    if(m) return m[1];
                    const m2 = u.match(/[?&]v=([A-Za-z0-9_-]{6,})/);
                    return m2 ? m2[1] : null;
                }catch(e){ return null; }
            }
            function extOf(u){
                const clean = u.split('#')[0].split('?')[0];
                const dot = clean.lastIndexOf('.');
                return dot < 0 ? '' : clean.slice(dot + 1).toLowerCase();
            }
            // Is `node` the sole content of its own paragraph (its own line)?
            function standaloneBlock(node){
                const p = node.closest('p');
                if(!p) return null;
                const others = Array.prototype.slice.call(p.children).filter(function(c){ return c !== node; });
                if(others.length) return null;
                const txt = p.textContent.replace(node.textContent || '', '').trim();
                return txt ? null : p;
            }
            function ytEmbed(id){
                const wrap = document.createElement('div');
                wrap.className = 'video-embed';
                const ifr = document.createElement('iframe');
                ifr.setAttribute('src', 'https://www.youtube.com/embed/' + id);
                ifr.setAttribute('title', 'YouTube video');
                ifr.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
                ifr.setAttribute('allowfullscreen', '');
                ifr.setAttribute('loading', 'lazy');
                wrap.appendChild(ifr);
                return wrap;
            }
            function player(tag, src){
                const el = document.createElement(tag);
                el.setAttribute('controls', '');
                el.setAttribute('preload', 'metadata');
                el.setAttribute('src', src);
                return el;
            }
            function mediaFor(url){
                const id = ytId(url);
                if(id) return ytEmbed(id);
                const ext = extOf(url);
                if(VIDEO_EXT.indexOf(ext) >= 0) return player('video', url);
                if(AUDIO_EXT.indexOf(ext) >= 0) return player('audio', url);
                return null;
            }

            // Links: embed only when the link is standalone on its own line (keep inline
            // references as plain links so prose is not broken).
            Array.prototype.slice.call(root.querySelectorAll('a[href]')).forEach(function(a){
                const made = mediaFor(a.getAttribute('href') || '');
                if(!made) return;
                const block = standaloneBlock(a);
                if(block) block.parentNode.replaceChild(made, block);
            });

            // Images: media-by-image-syntax becomes a player/embed; a real image gets
            // lazy-loading and a click-to-enlarge wrapper.
            Array.prototype.slice.call(root.querySelectorAll('img[src]')).forEach(function(img){
                if(!img.parentNode) return;
                const src = img.getAttribute('src') || '';
                const made = mediaFor(src);
                if(made){
                    const block = standaloneBlock(img);
                    if(block) block.parentNode.replaceChild(made, block);
                    else img.parentNode.replaceChild(made, img);
                    return;
                }
                img.setAttribute('loading', 'lazy');
                if(!img.closest('a')){   // don't hijack images the author already linked
                    img.classList.add('img-zoom');
                    img.addEventListener('click', function(){ openLightbox(img.src, img.alt); });
                }
            });
        })();

        // Folder expand/collapse toggle
        document.querySelectorAll('.folder-toggle').forEach((toggle) => {
            toggle.addEventListener('click', () => {
                toggle.parentElement.classList.toggle('expanded');
            });
        });

        // Sidebar collapse/expand (with mobile-default + persistence)
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebarToggle');
        const backdrop = document.getElementById('sidebarBackdrop');
        const MOBILE_BREAKPOINT = 768;
        const isMobile = () => window.innerWidth <= MOBILE_BREAKPOINT;

        const savedCollapsed = localStorage.getItem('mdSidebarCollapsed');
        const startCollapsed = (savedCollapsed === null) ? isMobile() : (savedCollapsed === 'true');
        document.body.classList.toggle('sidebar-collapsed', startCollapsed);
        toggleBtn.setAttribute('aria-expanded', String(!startCollapsed));

        const restoreSavedWidth = () => {
            // Desktop only: re-apply the user's last drag-resized width.
            if (isMobile()) { sidebar.style.width = ''; return; }
            const savedWidth = localStorage.getItem('mdSidebarWidth');
            if (savedWidth) {
                const w = parseInt(savedWidth, 10);
                if (w >= 120 && w <= window.innerWidth * 0.5) {
                    sidebar.style.width = w + 'px';
                }
            }
        };
        if (!startCollapsed) restoreSavedWidth();

        const setCollapsed = (collapsed) => {
            document.body.classList.toggle('sidebar-collapsed', collapsed);
            toggleBtn.setAttribute('aria-expanded', String(!collapsed));
            localStorage.setItem('mdSidebarCollapsed', String(collapsed));
            if (collapsed) {
                // Clear inline width so the .sidebar-collapsed rule (width: 0) wins.
                sidebar.style.width = '';
            } else {
                restoreSavedWidth();
            }
        };

        toggleBtn.addEventListener('click', () => {
            setCollapsed(!document.body.classList.contains('sidebar-collapsed'));
        });
        backdrop.addEventListener('click', () => setCollapsed(true));

        // Sidebar resize with mouse drag (desktop, expanded state only)
        const handle = document.getElementById('resizeHandle');
        let isResizing = false;

        handle.addEventListener('mousedown', (e) => {
            if (document.body.classList.contains('sidebar-collapsed') || isMobile()) return;
            isResizing = true;
            handle.classList.add('active');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isResizing) return;
            const newWidth = e.clientX;
            if (newWidth >= 120 && newWidth <= window.innerWidth * 0.5) {
                sidebar.style.width = newWidth + 'px';
            }
        });

        document.addEventListener('mouseup', () => {
            if (isResizing) {
                isResizing = false;
                handle.classList.remove('active');
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                localStorage.setItem('mdSidebarWidth', sidebar.offsetWidth);
            }
        });
    });
</script>
</body>
</html>
EOF
}

generate_api_template() {
    # Flat JSON index of every .md file, walked to a fixed depth of 5 (the default
    # MAX_FOLDER_DEPTH). Stored as a dotfile (.html so the templates directive
    # renders it) so it stays out of the sidebar/listing.
    rm -f "$SRV_DIR/.files.json.tmpl"   # remove any pre-1.x variant
    cat > "$SRV_DIR/.files-index.html" <<EOF
{{- \$files := list -}}
{{- \$trunc := false -}}
{{- range \$a := listFiles "/" -}}{{- if hasSuffix ".md" \$a -}}{{- \$files = append \$files (printf "/%s" \$a) -}}{{- end -}}{{- end -}}
{{- range \$a := listFiles "/" -}}{{- if and (not (hasPrefix "." \$a)) (not (contains "." \$a)) -}}
  {{- \$pa := printf "/%s" \$a -}}
  {{- range \$b := listFiles \$pa -}}{{- if hasSuffix ".md" \$b -}}{{- \$files = append \$files (printf "%s/%s" \$pa \$b) -}}{{- end -}}{{- end -}}
  {{- range \$b := listFiles \$pa -}}{{- if and (not (hasPrefix "." \$b)) (not (contains "." \$b)) -}}
    {{- \$pb := printf "%s/%s" \$pa \$b -}}
    {{- range \$c := listFiles \$pb -}}{{- if hasSuffix ".md" \$c -}}{{- \$files = append \$files (printf "%s/%s" \$pb \$c) -}}{{- end -}}{{- end -}}
    {{- range \$c := listFiles \$pb -}}{{- if and (not (hasPrefix "." \$c)) (not (contains "." \$c)) -}}
      {{- \$pc := printf "%s/%s" \$pb \$c -}}
      {{- range \$d := listFiles \$pc -}}{{- if hasSuffix ".md" \$d -}}{{- \$files = append \$files (printf "%s/%s" \$pc \$d) -}}{{- end -}}{{- end -}}
      {{- range \$d := listFiles \$pc -}}{{- if and (not (hasPrefix "." \$d)) (not (contains "." \$d)) -}}
        {{- \$pd := printf "%s/%s" \$pc \$d -}}
        {{- range \$e := listFiles \$pd -}}{{- if hasSuffix ".md" \$e -}}{{- \$files = append \$files (printf "%s/%s" \$pd \$e) -}}{{- end -}}{{- end -}}
        {{- range \$e := listFiles \$pd -}}{{- if and (not (hasPrefix "." \$e)) (not (contains "." \$e)) -}}{{- \$trunc = true -}}{{- end -}}{{- end -}}
      {{- end -}}{{- end -}}
    {{- end -}}{{- end -}}
  {{- end -}}{{- end -}}
{{- end -}}{{- end -}}
{"generated":"{{ now | date "2006-01-02T15:04:05Z07:00" }}","maxDepth":$MAX_FOLDER_DEPTH,"truncatedDepth":{{ \$trunc }},"count":{{ len \$files }},"files":[{{ range \$i, \$p := (sortAlpha \$files) }}{{ if \$i }},{{ end }}{"path":"{{ \$p }}","name":"{{ base \$p }}","raw":"/raw{{ \$p }}"}{{ end }}]}
EOF
}

