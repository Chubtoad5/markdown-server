#!/bin/bash
#
# install-md — Markdown Server installer (Chubtoad5)
#
# A Caddy-in-Docker static Markdown site with a folder-hierarchy sidebar.
# Conforms to the Chubtoad5 tooling conventions: runtime env-var overrides,
# distro detection, root requirement, JIT dependency fetch, tri-mode
# online/save/offline, and a per-run log.
#
# Modes: online install (default), `save` (build an air-gap bundle), and
# offline install (auto-detected when md-save.tar.gz is present). The agent
# API and upload UI arrive in later phases; the custom image already bundles
# the caddy-webdav module so those phases only add Caddyfile routes.

set -euo pipefail

SCRIPT_VERSION="1.1.0"
IPP_URL="https://github.com/Chubtoad5/images-pull-push/raw/refs/heads/main/image_pull_push.sh"

### ---- USER DEFINED VARIABLES (all runtime-overridable: sudo VAR=value ./install-md) ----
BASE_DIR="${BASE_DIR:-/opt/caddy-markdown}"           # Install and data directory
SRV_DIR="${SRV_DIR:-$BASE_DIR/srv}"                   # Markdown content directory
MGMT_IP="${MGMT_IP:-$(hostname -I | awk '{print $1}')}"  # Bind IP address
FQDN="${TLS_FQDN:-${FQDN:-md.$(hostname -f 2>/dev/null || hostname)}}"  # FQDN (TLS_FQDN alias accepted)
TCP_PORT="${TCP_PORT:-80}"                            # Listen port (use 443+ with TLS)
TLS_MODE="${TLS_MODE:-none}"                          # none | internal (self-signed) | auto (letsencrypt)
BROWSER_TITLE="${BROWSER_TITLE:-Markdown Server}"     # Browser tab title
CADDY_VERSION="${CADDY_VERSION:-latest}"              # Caddy base image tag (latest -> caddy:builder)
IMG_NAME="${IMG_NAME:-markdown-caddy}"                # Built (xcaddy+webdav) image repo name
MAX_FOLDER_DEPTH="${MAX_FOLDER_DEPTH:-5}"             # Sidebar/API folder nesting depth (guardrail)
AUTH_MODE="${AUTH_MODE:-basic}"                       # basic | none | forward — guards /admin + /dav writes
MD_ADMIN_USER="${MD_ADMIN_USER:-admin}"               # basic-auth username
MD_ADMIN_PASSWORD="${MD_ADMIN_PASSWORD:-changeme}"    # basic-auth password (CHANGE for production!)
ENABLE_WEBDAV="${ENABLE_WEBDAV:-true}"                # enable WebDAV (/dav) + upload UI (/admin)
FORWARD_AUTH_URL="${FORWARD_AUTH_URL:-}"              # AUTH_MODE=forward: IdP/Authentik outpost URL
ADMIN_HASH=""                                         # bcrypt hash of MD_ADMIN_PASSWORD (computed at install)

# Air-gap / asset settings
OFFLINE_SENTINEL="md-save.tar.gz"                     # Presence in cwd triggers offline mode
WEBDAV_MODULE="github.com/mholt/caddy-webdav"         # Caddy module baked into the custom image
ASSET_CSS_MD="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.2.0/github-markdown-dark.min.css"
ASSET_CSS_HL="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css"
ASSET_JS_HL="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"

LOG_FILE="$(pwd)/md-install.log"

_err() { echo "ERROR: install-md failed at line $1 (exit $2). See ${LOG_FILE} for details." >&2; }
trap '_err "$LINENO" "$?"' ERR

usage() {
    cat <<EOF
install-md — Markdown Server installer (Chubtoad5) v$SCRIPT_VERSION

Usage: sudo [VAR=value ...] ./install-md [command]

Commands:
  install     Install or refresh the Markdown Server (default if omitted).
              Offline install is automatic when ./md-save.tar.gz is present.
  save        Build an air-gap bundle (md-save.tar.gz): custom image + assets
              + Docker packages. Does not deploy.
  uninstall   Stop and remove the stack (backs up content first; MD_PURGE=true to skip)
  status      Show container status and an HTTP health probe
  version     Print installer and Caddy version info
  help        Show this help

Environment variables (override at runtime, e.g. sudo TCP_PORT=8080 ./install-md):
  BASE_DIR        Install/data directory          (default: /opt/caddy-markdown)
  SRV_DIR         Markdown content directory       (default: \$BASE_DIR/srv)
  MGMT_IP         Bind IP address                  (default: first host IP)
  FQDN            Server FQDN (TLS_FQDN alias)      (default: md.\$(hostname -f))
  TCP_PORT        Listen port                      (default: 80)
  TLS_MODE        none | internal | auto           (default: none)
  BROWSER_TITLE   Browser tab title                (default: Markdown Server)
  CADDY_VERSION   Caddy image tag                  (default: latest)
  MAX_FOLDER_DEPTH  Folder nesting shown in sidebar/API  (default: 5)
  AUTH_MODE         basic | none | forward (guards writes) (default: basic)
  MD_ADMIN_USER     basic-auth user                      (default: admin)
  MD_ADMIN_PASSWORD basic-auth password                  (default: changeme)
  ENABLE_WEBDAV     enable /dav + /admin upload UI        (default: true)
  FORWARD_AUTH_URL  IdP outpost URL (AUTH_MODE=forward)
  MD_RESET        true = wipe content on install (backup still taken)   (default: false)
  MD_PURGE        true = skip content backup on uninstall               (default: false)

Read endpoints (served by the running site):
  GET /raw/<path>.md      Raw markdown (text/markdown), no HTML layout
  GET /<path>.md?raw=1    Same, via content negotiation
  GET /api/files.json     JSON index of every .md file (recursive)
  GET /llms.txt           Discovery hint for AI agents

Write endpoints (when ENABLE_WEBDAV=true; auth per AUTH_MODE):
  GET  /admin             Browser upload / create / edit / delete UI
  WebDAV /dav/<path>      PUT / DELETE / MKCOL / MOVE (UI and AI agents)
EOF
}

show_version() {
    echo "install-md (markdown-server) v$SCRIPT_VERSION"
    echo "CADDY_VERSION: $CADDY_VERSION  (image: $(md_image), builder: $(caddy_builder_tag))"
    echo "custom image bundles the caddy-webdav module"
}

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "This script must be run as root." >&2
        exit 1
    fi
}

detect_distro() {
    if [[ ! -r /etc/os-release ]]; then
        echo "Error: /etc/os-release not found; cannot detect OS." >&2
        exit 1
    fi
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}" in
        ubuntu|debian|rhel|centos|rocky|almalinux|fedora|sles|opensuse-leap)
            echo "  Detected supported OS: ${ID} ${VERSION_ID:-}" ;;
        *)
            echo "Error: Unknown or unsupported OS '${ID:-unknown}'." >&2
            exit 1 ;;
    esac
}

port_in_use() {
    local p="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnH "( sport = :$p )" 2>/dev/null | grep -q .
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    else
        return 1  # no probe available; assume free
    fi
}

ensure_docker() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "  Docker and compose plugin present."
        return 0
    fi
    echo "  Docker or compose plugin missing — installing via images-pull-push (conventions §9)..."
    mkdir -p "$BASE_DIR/utilities"
    if [[ ! -x "$BASE_DIR/utilities/image_pull_push.sh" ]]; then
        curl -sfL "$IPP_URL" -o "$BASE_DIR/utilities/image_pull_push.sh"
        chmod +x "$BASE_DIR/utilities/image_pull_push.sh"
    fi
    ( cd "$BASE_DIR/utilities" && ./image_pull_push.sh docker )
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: Docker installation did not complete successfully." >&2
        exit 1
    fi
}

# ---- Image / asset / air-gap helpers ----

is_offline() { [[ -f "$(pwd)/$OFFLINE_SENTINEL" ]]; }

caddy_builder_tag() {
    if [[ "$CADDY_VERSION" == "latest" ]]; then echo "caddy:builder"; else echo "caddy:${CADDY_VERSION}-builder"; fi
}
caddy_runtime_tag() { echo "caddy:${CADDY_VERSION}"; }
md_image()    { echo "${IMG_NAME}:${CADDY_VERSION}"; }
image_tar()   { echo "markdown-caddy-image.tar.gz"; }

generate_dockerfile() {
    cat > "$BASE_DIR/Dockerfile" <<EOF
# Custom Caddy build with the WebDAV module (used by the upload UI + agent writes).
FROM $(caddy_builder_tag) AS builder
RUN xcaddy build --with $WEBDAV_MODULE
FROM $(caddy_runtime_tag)
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
EOF
}

build_image() {
    echo "  Building custom Caddy image $(md_image) (xcaddy + webdav)..."
    generate_dockerfile
    docker build -t "$(md_image)" -f "$BASE_DIR/Dockerfile" "$BASE_DIR"
}

fetch_assets() {
    echo "  Vendoring front-end assets for local (air-gap-safe) serving..."
    mkdir -p "$BASE_DIR/assets"
    curl -sfL "$ASSET_CSS_MD" -o "$BASE_DIR/assets/github-markdown-dark.min.css"
    curl -sfL "$ASSET_CSS_HL" -o "$BASE_DIR/assets/github-dark.min.css"
    curl -sfL "$ASSET_JS_HL"  -o "$BASE_DIR/assets/highlight.min.js"
}

extract_offline_bundle() {
    echo "  Extracting offline bundle ($OFFLINE_SENTINEL)..."
    mkdir -p "$BASE_DIR/.offline"
    rm -rf "$BASE_DIR/.offline"
    mkdir -p "$BASE_DIR/.offline" "$BASE_DIR/assets"
    tar xzf "$(pwd)/$OFFLINE_SENTINEL" -C "$BASE_DIR/.offline"
    cp -a "$BASE_DIR/.offline/assets/." "$BASE_DIR/assets/"
}

ensure_docker_offline() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "  Docker and compose plugin present."
        return 0
    fi
    echo "  Docker missing — installing from bundled offline packages..."
    local off="$BASE_DIR/.offline"
    if [[ -f "$off/offline-packages.tar.gz" && -x "$off/install_packages.sh" ]]; then
        ( cd "$off" && ./install_packages.sh offline docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin )
    else
        echo "Error: offline bundle has no Docker packages and Docker is not installed on this host." >&2
        exit 1
    fi
    command -v docker >/dev/null 2>&1 || { echo "Error: offline Docker install failed." >&2; exit 1; }
}

load_offline_image() {
    echo "  Loading custom Caddy image from bundle (no pull/build)..."
    gunzip -c "$BASE_DIR/.offline/image/$(image_tar)" | docker load
}

auth_block() {
    # Emits the auth directive for a write handle, per AUTH_MODE. Indented 8 spaces.
    case "$AUTH_MODE" in
        basic)
            echo "        basic_auth {"
            echo "            $MD_ADMIN_USER $ADMIN_HASH"
            echo "        }"
            ;;
        forward)
            echo "        forward_auth $FORWARD_AUTH_URL {"
            echo "            uri /outpost.goauthentik.io/auth/caddy"
            echo "            copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email"
            echo "        }"
            ;;
        none|*)
            echo "        # AUTH_MODE=none: write access is UNAUTHENTICATED (anyone can write/delete)"
            ;;
    esac
}

emit_write_handles() {
    echo
    echo "    # Upload / manage UI (auth-gated)."
    echo "    handle /admin* {"
    auth_block
    echo "        rewrite * /.admin.html"
    echo "        file_server"
    echo "    }"
    echo
    echo "    # WebDAV write API for the UI and AI agents (auth-gated)."
    echo "    handle /dav/* {"
    auth_block
    echo "        uri strip_prefix /dav"
    echo "        webdav"
    echo "    }"
}

generate_caddyfile() {
    local cfile="$BASE_DIR/Caddyfile"
    : > "$cfile"

    # Global options block — only emitted when something needs it.
    if [[ "$ENABLE_WEBDAV" == "true" || "$TLS_MODE" == "internal" ]]; then
        {
            echo "{"
            [[ "$ENABLE_WEBDAV" == "true" ]] && echo "    order webdav before file_server"
            [[ "$TLS_MODE" == "internal" ]] && echo "    default_sni $MGMT_IP"
            echo "}"
        } >> "$cfile"
    fi

    local site
    if [[ "$TLS_MODE" == "none" ]]; then
        echo "  Configuring HTTP on port $TCP_PORT (any host — IP, hostname, or FQDN all work)"
        site=":$TCP_PORT"
    elif [[ "$TLS_MODE" == "internal" ]]; then
        echo "  Configuring HTTPS (self-signed) on port $TCP_PORT for IP $MGMT_IP and FQDN $FQDN"
        site="https://$MGMT_IP:$TCP_PORT https://$FQDN:$TCP_PORT"
    else
        echo "  Configuring HTTPS (Let's Encrypt) on port $TCP_PORT for FQDN $FQDN"
        echo "  NOTE: TLS_MODE=auto needs a public, resolvable FQDN; IP-only access is not possible with Let's Encrypt."
        site="$FQDN:$TCP_PORT"
    fi

    {
        echo "$site {"
        [[ "$TLS_MODE" == "internal" ]] && echo "    tls internal"
        cat <<'ROUTES_HEAD'
    root * /srv

    # Vendored CSS/JS, served locally so the page renders fully offline.
    handle /_assets/* {
        root * /assets
        uri strip_prefix /_assets
        file_server
    }

    # Raw markdown for AI agents (no HTML layout).
    handle /raw/* {
        uri strip_prefix /raw
        header Content-Type "text/markdown; charset=utf-8"
        file_server
    }

    # JSON index of every markdown file (live, recursive).
    # templates only renders allowed MIME types, and the header sets
    # application/json before templates runs — so add it to the mime list.
    handle /api/files.json {
        rewrite * /.files-index.html
        header Content-Type "application/json; charset=utf-8"
        templates {
            mime application/json text/html
        }
        file_server
    }

    # Discovery hint for AI agents.
    handle /llms.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond `# Markdown Server
This site renders Markdown as HTML. For raw/source access (AI agents):
- Raw file:   GET /raw/<path>.md     (Content-Type: text/markdown)
- Or append:  ?raw=1 to any .md URL
- File index: GET /api/files.json     (JSON list of every .md path)
- Write API:  WebDAV under /dav/ (PUT/DELETE/MKCOL/MOVE) when enabled
` 200
    }

    # Content negotiation: ?raw=1 returns raw markdown without the layout.
    @rawquery {
        path *.md
        query raw=1
    }
    handle @rawquery {
        header Content-Type "text/markdown; charset=utf-8"
        file_server
    }
ROUTES_HEAD

        # Write path: WebDAV + admin UI (auth-gated), only when enabled.
        if [[ "$ENABLE_WEBDAV" == "true" ]]; then
            emit_write_handles
        fi

        cat <<'ROUTES_TAIL'

    # Rendered Markdown site (folder sidebar + GitHub theme).
    handle {
        templates
        @markdown_site path / *.md
        rewrite @markdown_site /layout.html
        file_server
    }
}
ROUTES_TAIL
    } >> "$cfile"
}

generate_layout() {
    cat > "$SRV_DIR/layout.html" <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>$BROWSER_TITLE</title>
    <link rel="stylesheet" href="/_assets/github-markdown-dark.min.css">
    <link rel="stylesheet" href="/_assets/github-dark.min.css">
    <style>
        :root {
            --sidebar-bg: #0d1117;
            --content-bg: #161b22;
            --code-bg: #0d1117;
            --text-main: #c9d1d9;
            --accent: #58a6ff;
            --sidebar-border: #30363d;
            --link-color: #8b949e;
            --sidebar-width: 195px;
        }

        body {
            display: flex; margin: 0; height: 100vh; overflow: hidden;
            font-family: -apple-system, system-ui, sans-serif;
            background-color: var(--content-bg); color: var(--text-main);
        }

        nav {
            width: var(--sidebar-width); min-width: 120px; max-width: 50vw;
            box-sizing: border-box; background-color: var(--sidebar-bg);
            border-right: 1px solid var(--sidebar-border);
            padding: 25px 15px; overflow-y: auto; flex-shrink: 0;
        }

        nav h3 { font-size: 10px; color: #8b949e; text-transform: uppercase; margin-bottom: 15px; letter-spacing: 1px; }
        nav ul { list-style: none; padding: 0; margin: 0; }
        nav li { margin-bottom: 4px; }

        nav a {
            display: block; padding: 10px 12px; font-size: 13px;
            color: var(--link-color) !important; text-decoration: none !important;
            border-radius: 6px; white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis; min-height: 1.2em;
        }

        nav a:hover { background-color: #21262d; color: var(--accent) !important; }
        nav a.active { background-color: #1f6feb; color: #ffffff !important; font-weight: 600; }

        .depth-limit { display: block; padding: 8px 12px; font-size: 11px; color: #6e7681; font-style: italic; }

        /* Folder styles */
        .folder-toggle {
            display: flex; align-items: center; padding: 10px 12px; font-size: 13px;
            color: var(--link-color); cursor: pointer; border-radius: 6px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            user-select: none; font-weight: 600;
        }
        .folder-toggle:hover { background-color: #21262d; color: var(--accent); }
        .folder-toggle::before {
            content: '\25B6'; display: inline-block; margin-right: 8px; font-size: 9px;
            transition: transform 0.2s ease; flex-shrink: 0;
        }
        .folder.expanded > .folder-toggle::before { transform: rotate(90deg); }
        .folder-contents { display: none; padding-left: 12px; }
        .folder.expanded > .folder-contents { display: block; }

        /* Resize handle */
        .resize-handle {
            width: 5px; cursor: col-resize; background-color: transparent;
            flex-shrink: 0; transition: background-color 0.15s;
        }
        .resize-handle:hover, .resize-handle.active { background-color: var(--accent); }

        main { flex-grow: 1; overflow-y: auto; background-color: var(--content-bg); }
        .markdown-body { box-sizing: border-box; width: 100%; max-width: 100%; padding: 50px; background-color: transparent !important; }

        .markdown-body pre { position: relative; background-color: var(--code-bg) !important; border: 1px solid #30363d !important; border-radius: 8px; padding: 16px; }

        .copy-code-button { position: absolute; top: 10px; right: 10px; padding: 4px 8px; background-color: #21262d; color: #8b949e; border: 1px solid #30363d; border-radius: 6px; font-size: 11px; cursor: pointer; opacity: 0; transition: opacity 0.2s; z-index: 10; }
        pre:hover .copy-code-button { opacity: 1; }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--sidebar-bg); }
        ::-webkit-scrollbar-thumb { background: #30363d; border-radius: 10px; }
    </style>
</head>
<body>

{{ define "navtree" }}
  {{ \$dir := .dir }}{{ \$depth := .depth }}{{ \$max := .max }}{{ \$req := .req }}
  {{/* markdown files directly in this directory (sorted) */}}
  {{ \$files := list }}
  {{ range listFiles \$dir }}
    {{ if and (hasSuffix ".md" .) (not (and (eq \$dir "/") (eq . "index.md"))) }}
      {{ \$files = append \$files . }}
    {{ end }}
  {{ end }}
  {{ range sortAlpha \$files }}
    {{ \$href := printf "%s/%s" (trimSuffix "/" \$dir) . }}
    <li><a href="{{ \$href }}" class="{{ if eq \$req \$href }}active{{ end }}">{{ . | trimSuffix ".md" | replace "-" " " }}</a></li>
  {{ end }}
  {{/* subdirectories: dotless names only (files have extensions) */}}
  {{ \$dirs := list }}
  {{ range listFiles \$dir }}
    {{ if and (not (hasPrefix "." .)) (not (contains "." .)) }}
      {{ \$dirs = append \$dirs . }}
    {{ end }}
  {{ end }}
  {{ if \$dirs }}
    {{ if lt \$depth \$max }}
      {{ range sortAlpha \$dirs }}
        {{ \$child := printf "%s/%s" (trimSuffix "/" \$dir) . }}
        {{ \$open := hasPrefix (printf "%s/" \$child) \$req }}
        <li class="folder{{ if \$open }} expanded{{ end }}">
          <div class="folder-toggle">{{ . | replace "-" " " }}</div>
          <ul class="folder-contents">
            {{ template "navtree" (dict "dir" \$child "depth" (add \$depth 1) "max" \$max "req" \$req) }}
          </ul>
        </li>
      {{ end }}
    {{ else }}
      <li><span class="depth-limit">&#9888; {{ len \$dirs }} nested folder(s) beyond {{ \$max }} levels not shown</span></li>
    {{ end }}
  {{ end }}
{{ end }}
<nav id="sidebar">
  <h3>Navigation</h3>
  <ul>
    {{ \$req := \$.OriginalReq.URL.Path }}
    <li><a href="/" class="{{ if or (eq \$req "/") (eq \$req "") }}active{{ end }}">Home</a></li>
    {{ template "navtree" (dict "dir" "/" "depth" 1 "max" $MAX_FOLDER_DEPTH "req" \$req) }}
  </ul>
</nav>

<div class="resize-handle" id="resizeHandle"></div>

<main>
    <article class="markdown-body">
        {{\$req := .OriginalReq.URL.Path}}
        {{if or (eq \$req "/") (eq \$req "")}}
            {{markdown (readFile "index.md")}}
        {{else}}
            {{markdown (readFile \$req)}}
        {{end}}
    </article>
</main>

<script src="/_assets/highlight.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        hljs.highlightAll();

        // Copy code button
        document.querySelectorAll('pre').forEach((codeBlock) => {
            const button = document.createElement('button');
            button.className = 'copy-code-button';
            button.innerText = 'Copy';
            button.addEventListener('click', () => {
                const text = codeBlock.querySelector('code').innerText;
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    button.innerText = 'Copied!';
                } catch (err) { button.innerText = 'Error'; }
                document.body.removeChild(textArea);
                setTimeout(() => { button.innerText = 'Copy'; }, 2000);
            });
            codeBlock.appendChild(button);
        });

        // Folder expand/collapse toggle
        document.querySelectorAll('.folder-toggle').forEach((toggle) => {
            toggle.addEventListener('click', () => {
                toggle.parentElement.classList.toggle('expanded');
            });
        });

        // Sidebar resize with mouse drag
        const sidebar = document.getElementById('sidebar');
        const handle = document.getElementById('resizeHandle');
        let isResizing = false;

        // Restore saved sidebar width
        const savedWidth = localStorage.getItem('mdSidebarWidth');
        if (savedWidth) {
            const w = parseInt(savedWidth, 10);
            if (w >= 120 && w <= window.innerWidth * 0.5) {
                sidebar.style.width = w + 'px';
            }
        }

        handle.addEventListener('mousedown', (e) => {
            isResizing = true;
            handle.classList.add('active');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isResizing) return;
            const newWidth = e.clientX;
            if (newWidth >= 120 && newWidth <= window.innerWidth * 0.5) {
                sidebar.style.width = newWidth + 'px';
            }
        });

        document.addEventListener('mouseup', () => {
            if (isResizing) {
                isResizing = false;
                handle.classList.remove('active');
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                localStorage.setItem('mdSidebarWidth', sidebar.offsetWidth);
            }
        });
    });
</script>
</body>
</html>
EOF
}

generate_api_template() {
    # Flat JSON index of every .md file, walked to a fixed depth of 5 (the default
    # MAX_FOLDER_DEPTH). Stored as a dotfile (.html so the templates directive
    # renders it) so it stays out of the sidebar/listing.
    rm -f "$SRV_DIR/.files.json.tmpl"   # remove any pre-1.x variant
    cat > "$SRV_DIR/.files-index.html" <<EOF
{{- \$files := list -}}
{{- \$trunc := false -}}
{{- range \$a := listFiles "/" -}}{{- if hasSuffix ".md" \$a -}}{{- \$files = append \$files (printf "/%s" \$a) -}}{{- end -}}{{- end -}}
{{- range \$a := listFiles "/" -}}{{- if and (not (hasPrefix "." \$a)) (not (contains "." \$a)) -}}
  {{- \$pa := printf "/%s" \$a -}}
  {{- range \$b := listFiles \$pa -}}{{- if hasSuffix ".md" \$b -}}{{- \$files = append \$files (printf "%s/%s" \$pa \$b) -}}{{- end -}}{{- end -}}
  {{- range \$b := listFiles \$pa -}}{{- if and (not (hasPrefix "." \$b)) (not (contains "." \$b)) -}}
    {{- \$pb := printf "%s/%s" \$pa \$b -}}
    {{- range \$c := listFiles \$pb -}}{{- if hasSuffix ".md" \$c -}}{{- \$files = append \$files (printf "%s/%s" \$pb \$c) -}}{{- end -}}{{- end -}}
    {{- range \$c := listFiles \$pb -}}{{- if and (not (hasPrefix "." \$c)) (not (contains "." \$c)) -}}
      {{- \$pc := printf "%s/%s" \$pb \$c -}}
      {{- range \$d := listFiles \$pc -}}{{- if hasSuffix ".md" \$d -}}{{- \$files = append \$files (printf "%s/%s" \$pc \$d) -}}{{- end -}}{{- end -}}
      {{- range \$d := listFiles \$pc -}}{{- if and (not (hasPrefix "." \$d)) (not (contains "." \$d)) -}}
        {{- \$pd := printf "%s/%s" \$pc \$d -}}
        {{- range \$e := listFiles \$pd -}}{{- if hasSuffix ".md" \$e -}}{{- \$files = append \$files (printf "%s/%s" \$pd \$e) -}}{{- end -}}{{- end -}}
        {{- range \$e := listFiles \$pd -}}{{- if and (not (hasPrefix "." \$e)) (not (contains "." \$e)) -}}{{- \$trunc = true -}}{{- end -}}{{- end -}}
      {{- end -}}{{- end -}}
    {{- end -}}{{- end -}}
  {{- end -}}{{- end -}}
{{- end -}}{{- end -}}
