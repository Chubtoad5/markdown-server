#!/bin/bash
#
# install-md — Markdown Server installer (Chubtoad5)
#
# A Caddy-in-Docker static Markdown site with a folder-hierarchy sidebar.
# Conforms to the Chubtoad5 tooling conventions: runtime env-var overrides,
# distro detection, root requirement, JIT dependency fetch, tri-mode
# online/save/offline, and a per-run log.
#
# Modes: online install (default), `save` (build an air-gap bundle), and
# offline install (auto-detected when md-save.tar.gz is present). The agent
# API and upload UI arrive in later phases; the custom image already bundles
# the caddy-webdav module so those phases only add Caddyfile routes.
#
# Private registry (v1.2): `push` builds then pushes the custom image to an OCI
# registry (e.g. Harbor); `-registry <host:port> <user> <pass>` alone skips the
# build and pulls-and-runs that pushed image instead. The image bakes its assets
# in, so a registry-pulled image renders fully offline. Conventions mirror the
# sibling installers (rke2/seaweedfs): `-registry` takes three positional args.

set -euo pipefail

SCRIPT_VERSION="1.7.0"
# Helper scripts come from releases, not main (spec 14, as spec 12 did for rke2 and SeaweedFS). A URL wins over its ref,
# IPP_URL still works as an alias for IMAGE_PULL_PUSH_URL, and a checksum is optional.
IMAGE_PULL_PUSH_REF="${IMAGE_PULL_PUSH_REF:-v1.1.1}"
IMAGE_PULL_PUSH_URL="${IMAGE_PULL_PUSH_URL:-${IPP_URL:-https://raw.githubusercontent.com/Chubtoad5/images-pull-push/${IMAGE_PULL_PUSH_REF}/image_pull_push.sh}}"
IMAGE_PULL_PUSH_SHA256="${IMAGE_PULL_PUSH_SHA256:-}"
IPP_URL="$IMAGE_PULL_PUSH_URL"
INSTALL_PACKAGES_REF="${INSTALL_PACKAGES_REF:-v1.1.3}"
INSTALL_PACKAGES_URL="${INSTALL_PACKAGES_URL:-https://raw.githubusercontent.com/Chubtoad5/install-packages/${INSTALL_PACKAGES_REF}/install_packages.sh}"
INSTALL_PACKAGES_SHA256="${INSTALL_PACKAGES_SHA256:-}"
# Who the save bundle's written offer for its GPL/LGPL parts tells people to ask for source code
LICENSE_OFFER_CONTACT="${LICENSE_OFFER_CONTACT:-the Chubtoad5 project via https://github.com/Chubtoad5}"
export INSTALL_PACKAGES_REF          # image_pull_push.sh reads it too, so one setting covers both helpers
MD_OFFLINE=0                         # set by an install from the offline bundle: the helpers are never downloaded then

### ---- USER DEFINED VARIABLES (all runtime-overridable: sudo VAR=value ./install-md) ----
BASE_DIR="${BASE_DIR:-/opt/caddy-markdown}"           # Install and data directory
SRV_DIR="${SRV_DIR:-$BASE_DIR/srv}"                   # Markdown content directory
MGMT_IP="${MGMT_IP:-$(hostname -I | awk '{print $1}')}"  # Bind IP address
FQDN="${TLS_FQDN:-${FQDN:-md.$(hostname -f 2>/dev/null || hostname)}}"  # FQDN (TLS_FQDN alias accepted)
TCP_PORT="${TCP_PORT:-80}"                            # Listen port (use 443+ with TLS)
TLS_MODE="${TLS_MODE:-none}"                          # none | internal (self-signed) | auto (letsencrypt)
BROWSER_TITLE="${BROWSER_TITLE:-Markdown Server}"     # Browser tab title
CADDY_VERSION="${CADDY_VERSION:-latest}"              # Caddy base image tag (latest -> caddy:builder)
IMG_NAME="${IMG_NAME:-markdown-caddy}"                # Built (xcaddy+webdav) image repo name
MAX_FOLDER_DEPTH="${MAX_FOLDER_DEPTH:-5}"             # Sidebar/API folder nesting depth (guardrail)
AUTH_MODE="${AUTH_MODE:-basic}"                       # basic | none | forward — guards /admin + /dav writes
MD_ADMIN_USER="${MD_ADMIN_USER:-}"                    # basic-auth username (default: the last install's, else admin)
ADMIN_PASSWORD_GIVEN="${MD_ADMIN_PASSWORD+x}"         # x when MD_ADMIN_PASSWORD is set at all, even to "" (refused)
MD_ADMIN_PASSWORD="${MD_ADMIN_PASSWORD-}"             # basic-auth password (default: the last install's, else changeme)
ENABLE_WEBDAV="${ENABLE_WEBDAV:-true}"                # enable WebDAV (/dav) + upload UI (/admin)
FORWARD_AUTH_URL="${FORWARD_AUTH_URL:-}"              # AUTH_MODE=forward: IdP/Authentik outpost URL
ADMIN_HASH=""                                         # Caddy's hash of the admin password: the stored one, or made at install
ADMIN_FINGERPRINT=""                                  # ties ADMIN_HASH to its password, in .auth-hash (empty when unknown)
ADMIN_PASSWORD_SOURCE=""                              # given | kept | default: what the closing banner says about it

# Private registry (push to / pull-and-run from an OCI registry, e.g. Harbor).
# Primary input is the `-registry <host:port> <user> <pass>` CLI triple; these
# env-vars are the fallback (and keep the password out of `ps` when preferred).
REGISTRY_INFO="${REGISTRY_INFO:-}"                    # <host:port> of the private registry
REG_USER="${REG_USER:-}"                              # registry username
REG_PASS="${REG_PASS:-}"                              # registry password
REGISTRY_NS="${REGISTRY_NS:-library}"                 # registry project/namespace (Harbor default: library)
PUSH_MODE=0                                           # set by the `push` command token
REGISTRY_MODE=0                                       # set when a registry is provided
REG_FQDN=""                                           # derived from REGISTRY_INFO
REG_PORT=""                                           # derived from REGISTRY_INFO
FQDN_PATTERN='^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$'
IPV4_PATTERN='^([0-9]{1,3}\.){3}[0-9]{1,3}$'

# Air-gap / asset settings
OFFLINE_SENTINEL="md-save.tar.gz"                     # Presence in cwd triggers offline mode
WEBDAV_MODULE="github.com/mholt/caddy-webdav"         # Caddy module baked into the custom image
ASSET_CSS_MD="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.2.0/github-markdown-dark.min.css"
ASSET_CSS_HL="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css"
ASSET_JS_HL="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"

LOG_FILE="$(pwd)/md-install.log"

_err() { echo "ERROR: install-md failed at line $1 (exit $2). See ${LOG_FILE} for details." >&2; }
trap '_err "$LINENO" "$?"' ERR

usage() {
    cat <<EOF
install-md — Markdown Server installer (Chubtoad5) v$SCRIPT_VERSION

Usage: sudo [VAR=value ...] ./install-md [command] [push] [-registry <host:port> <user> <pass>]

Commands:
  install     Install or refresh the Markdown Server (default if omitted).
              Offline install is automatic when ./md-save.tar.gz is present.
  save        Build an air-gap bundle (md-save.tar.gz): custom image
              + Docker packages. Does not deploy. (Combine with 'push' to also
              push the freshly built image to a registry.)
  uninstall   Stop and remove the stack (backs up content first; MD_PURGE=true to skip)
  status      Show container status and an HTTP health probe
  version     Print installer and Caddy version info
  help        Show this help

Private registry:
  push                          Build the custom image, then push it to the registry.
                                Requires -registry. Valid with 'install' and 'save'.
  -registry <host:port> <user> <pass>
                                Target OCI registry (e.g. Harbor). Three positional
                                args, matching the sibling installers.
                                * with push    -> build (or load from bundle) then push.
                                * without push -> SKIP the build and pull-and-run the
                                                  image from the registry (valid with
                                                  'install' only).
                                The image is pushed as <host:port>/<REGISTRY_NS>/markdown-caddy:<ver>
                                (REGISTRY_NS default: library). Credentials may instead
                                be supplied via REGISTRY_INFO / REG_USER / REG_PASS env-vars.

Examples:
  sudo ./install-md install push -registry harbor.lab:443 admin Harbor12345   # build + push + run from registry
  sudo ./install-md install -registry harbor.lab:443 admin Harbor12345        # pull-and-run (no build)
  sudo ./install-md save push -registry harbor.lab:443 admin Harbor12345      # build + air-gap bundle + push

Environment variables (override at runtime, e.g. sudo TCP_PORT=8080 ./install-md):
  BASE_DIR        Install/data directory          (default: /opt/caddy-markdown)
  SRV_DIR         Markdown content directory       (default: \$BASE_DIR/srv)
  MGMT_IP         Bind IP address                  (default: first host IP)
  FQDN            Server FQDN (TLS_FQDN alias)      (default: md.\$(hostname -f))
  TCP_PORT        Listen port                      (default: 80)
  TLS_MODE        none | internal | auto           (default: none)
  BROWSER_TITLE   Browser tab title                (default: Markdown Server)
  CADDY_VERSION   Caddy image tag                  (default: latest)
  MAX_FOLDER_DEPTH  Folder nesting shown in sidebar/API  (default: 5)
  AUTH_MODE         basic | none | forward (guards writes) (default: basic)
  MD_ADMIN_USER     basic-auth user: letters, digits and . _ @ + -
                    (default: the last install's; admin on a first install)
  MD_ADMIN_PASSWORD basic-auth password, up to 128 characters, no control characters
                    (default: the last install's; changeme on a first install)
  ENABLE_WEBDAV     enable /dav + /admin upload UI        (default: true)
  FORWARD_AUTH_URL  IdP outpost URL (AUTH_MODE=forward)
  MD_RESET        true = wipe content on install (backup still taken)   (default: false)
  MD_PURGE        true = skip content backup on uninstall               (default: false)
  REGISTRY_NS     Registry project/namespace for the image             (default: library)
  REGISTRY_INFO   Registry <host:port> (env-var alternative to -registry)
  REG_USER        Registry username (env-var alternative)
  REG_PASS        Registry password (env-var alternative)

Read endpoints (served by the running site):
  GET /raw/<path>.md      Raw markdown (text/markdown), no HTML layout
  GET /<path>.md?raw=1    Same, via content negotiation
  GET /api/files.json     JSON index of every .md file (recursive)
  GET /llms.txt           Discovery hint for AI agents

Write endpoints (when ENABLE_WEBDAV=true; auth per AUTH_MODE):
  GET  /admin             Browser upload / create / edit / delete UI
  WebDAV /dav/<path>      PUT / DELETE / MKCOL / MOVE (UI and AI agents)
EOF
}

show_version() {
    echo "install-md (markdown-server) v$SCRIPT_VERSION"
    echo "CADDY_VERSION: $CADDY_VERSION  (image: $(md_image), builder: $(caddy_builder_tag))"
    echo "custom image bundles the caddy-webdav module"
}

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "This script must be run as root." >&2
        exit 1
    fi
}

detect_distro() {
    if [[ ! -r /etc/os-release ]]; then
        echo "Error: /etc/os-release not found; cannot detect OS." >&2
        exit 1
    fi
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}" in
        ubuntu|debian|rhel|centos|rocky|almalinux|fedora|sles|opensuse-leap)
            echo "  Detected supported OS: ${ID} ${VERSION_ID:-}" ;;
        *)
            echo "Error: Unknown or unsupported OS '${ID:-unknown}'." >&2
            exit 1 ;;
    esac
}

port_in_use() {
    local p="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnH "( sport = :$p )" 2>/dev/null | grep -q .
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    else
        return 1  # no probe available; assume free
    fi
}

# fetch_helper <dest> <url> <ref> [sha256]: a helper script at a given ref (spec 14, as Harbor does). A copy is reused
# only when the .ref file beside it names the same ref; any other copy is fetched again. A failed download or a
# checksum mismatch leaves no file behind.
fetch_helper() {
    local dest=$1 url=$2 ref=$3 sha=${4:-} ref_file
    ref_file="$(dirname "$dest")/.$(basename "$dest").ref"
    if [[ -s "$dest" && "$(cat "$ref_file" 2>/dev/null)" == "$ref" ]]; then
        return 0
    fi
    echo "  Downloading $(basename "$dest") ($ref)..."
    if ! curl -fsSL "$url" -o "$dest.tmp"; then
        rm -f "$dest.tmp"
        echo "Error: failed to download $url" >&2
        return 1
    fi
    if [[ -n "$sha" ]] && ! echo "$sha  $dest.tmp" | sha256sum -c --status; then
        rm -f "$dest.tmp"
        echo "Error: $(basename "$dest") from $url doesn't match its checksum." >&2
        return 1
    fi
    mv "$dest.tmp" "$dest"
    chmod +x "$dest"
    printf '%s\n' "$ref" > "$ref_file"
}

# helper_check <file> <url> <ref> [sha256]: the helper in utilities/. An install from the offline bundle never
# downloads it: it uses a copy already there, or the bundle's own (v1.6.0+ bundles carry both helpers). A save always
# fetches the pinned copy.
helper_check() {
    local dest="$BASE_DIR/utilities/$1" bundled="$BASE_DIR/.offline/$1"
    mkdir -p "$BASE_DIR/utilities"
    if [[ $MD_OFFLINE -eq 1 ]]; then
        [[ -s "$dest" ]] && return 0
        if [[ -s "$bundled" ]]; then
            cp "$bundled" "$dest" && chmod +x "$dest" || { echo "Error: couldn't copy the bundle's $1 into $BASE_DIR/utilities." >&2; exit 1; }
            [[ -f "$BASE_DIR/.offline/.$1.ref" ]] && cp "$BASE_DIR/.offline/.$1.ref" "$(dirname "$dest")/.$1.ref"
            return 0
        fi
        echo "Error: installing from the offline bundle ($OFFLINE_SENTINEL), which has no $1. Nothing is downloaded offline." >&2
        echo "  Use a bundle built by markdown-server 1.6.0 or later, or move $OFFLINE_SENTINEL out of this folder to install online." >&2
        exit 1
    fi
    if ! fetch_helper "$dest" "$2" "$3" "${4:-}"; then
        echo "Error: couldn't fetch $1. Check network access, or point ${5:-its _URL setting} at a mirror." >&2
        exit 1
    fi
}

# The shared images-pull-push helper (Docker install, registry-cert trust), so all callers reuse the same copy.
ensure_ipp() {
    helper_check image_pull_push.sh "$IMAGE_PULL_PUSH_URL" "$IMAGE_PULL_PUSH_REF" "$IMAGE_PULL_PUSH_SHA256" IMAGE_PULL_PUSH_URL
}

ensure_docker() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "  Docker and compose plugin present."
        return 0
    fi
    echo "  Docker or compose plugin missing — installing via images-pull-push (conventions §9)..."
    ensure_ipp
    ( cd "$BASE_DIR/utilities" && ./image_pull_push.sh docker )
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: Docker installation did not complete successfully." >&2
        exit 1
    fi
}

# ---- Private registry helpers ----

# Fully-qualified image reference in the private registry. Bare image name
# (markdown-caddy) lands under the REGISTRY_NS project — matches how
# image_pull_push and Harbor namespace unscoped images (default: library/).
registry_image_ref() { echo "${REG_FQDN}:${REG_PORT}/${REGISTRY_NS}/${IMG_NAME}:${CADDY_VERSION}"; }

# The image the compose file actually runs: the registry ref whenever a registry
# is in play (push or pull), otherwise the locally built image.
runtime_image() {
    if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then registry_image_ref; else md_image; fi
}

# Retrieve + trust the registry's TLS certificate (Harbor self-signed CA, etc.)
# via the shared helper. Soft-fail: a publicly-trusted CA needs no local trust.
ensure_reg_cert() {
    echo "  Trusting the registry TLS certificate ($REGISTRY_INFO)..."
    ensure_ipp
    if ! ( cd "$BASE_DIR/utilities" && ./image_pull_push.sh reg-cert "$REGISTRY_INFO" ); then
        echo "  NOTE: reg-cert step did not complete; continuing (OK if the registry uses a public CA)."
    fi
}

registry_login() {
    echo "  Logging in to registry $REG_FQDN:$REG_PORT as $REG_USER..."
    docker login "$REG_FQDN:$REG_PORT" --username "$REG_USER" --password-stdin <<< "$REG_PASS"
}

# Tag the locally built image with its registry ref and push it. (The shared
# image_pull_push 'push' can't be used here: it pulls every image from the
# internet first, but markdown-caddy exists only as a local build.)
push_image() {
    local ref; ref="$(registry_image_ref)"
    echo "  Tagging $(md_image) -> $ref and pushing..."
    docker tag "$(md_image)" "$ref"
    docker push "$ref"
    echo "  Pushed $ref"
}

# ---- Image / asset / air-gap helpers ----

is_offline() { [[ -f "$(pwd)/$OFFLINE_SENTINEL" ]]; }

caddy_builder_tag() {
    if [[ "$CADDY_VERSION" == "latest" ]]; then echo "caddy:builder"; else echo "caddy:${CADDY_VERSION}-builder"; fi
}
caddy_runtime_tag() { echo "caddy:${CADDY_VERSION}"; }
md_image()    { echo "${IMG_NAME}:${CADDY_VERSION}"; }
image_tar()   { echo "markdown-caddy-image.tar.gz"; }

generate_dockerfile() {
    cat > "$BASE_DIR/Dockerfile" <<EOF
# Custom Caddy build with the WebDAV module (used by the upload UI + agent writes).
FROM $(caddy_builder_tag) AS builder
RUN xcaddy build --with $WEBDAV_MODULE
FROM $(caddy_runtime_tag)
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
# Bake the vendored front-end assets into the image so a registry-pulled (or
# offline-loaded) image renders fully — no bind-mount or CDN needed at runtime.
COPY assets /assets
EOF
    # Keep the build context tiny: only the assets dir is needed (the Dockerfile
    # itself is passed via -f). Avoids shipping srv/, bundles, utilities, etc.
    cat > "$BASE_DIR/.dockerignore" <<'EOF'
*
!assets
EOF
}

build_image() {
    echo "  Building custom Caddy image $(md_image) (xcaddy + webdav, assets baked in)..."
    [[ -d "$BASE_DIR/assets" && -n "$(ls -A "$BASE_DIR/assets" 2>/dev/null)" ]] || fetch_assets
    generate_dockerfile
    # No provenance attestation: it carries the build time, so with Docker's containerd image store every rebuild got a
    # new image ID, even from cache, and compose then recreated Caddy on every re-run (spec 21, Q5). The legacy
    # builder ignores the setting.
    BUILDX_NO_DEFAULT_ATTESTATIONS=1 docker build -t "$(md_image)" -f "$BASE_DIR/Dockerfile" "$BASE_DIR"
}

fetch_assets() {
    echo "  Vendoring front-end assets for local (air-gap-safe) serving..."
    mkdir -p "$BASE_DIR/assets"
    curl -sfL "$ASSET_CSS_MD" -o "$BASE_DIR/assets/github-markdown-dark.min.css"
    curl -sfL "$ASSET_CSS_HL" -o "$BASE_DIR/assets/github-dark.min.css"
    curl -sfL "$ASSET_JS_HL"  -o "$BASE_DIR/assets/highlight.min.js"
}

extract_offline_bundle() {
    echo "  Extracting offline bundle ($OFFLINE_SENTINEL)..."
    rm -rf "$BASE_DIR/.offline"
    mkdir -p "$BASE_DIR/.offline"
    tar xzf "$(pwd)/$OFFLINE_SENTINEL" -C "$BASE_DIR/.offline"
}

# The Docker packages for this distro, as images-pull-push picks them. SUSE has no Docker CE, so it uses its own (spec
# 15, F2).
docker_packages() {
    case "${ID:-}" in
        sles|opensuse-leap) echo "docker docker-compose" ;;
        *) echo "docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin" ;;
    esac
}

# On an EL host, the running kernel's kernel-modules-extra when this host's repos still have it, so that the bundle carries
# it. A target built from the same image then gets xt_addrtype with no local media (spec 15, F1). Prints nothing
# elsewhere, and a note on stderr when the repos no longer have it.
el_modules_extra_pkg() {
    case "${ID:-}" in rhel|centos|rocky|almalinux|fedora) ;; *) return 0 ;; esac
    local pkg
    pkg="kernel-modules-extra-$(uname -r)"
    if [[ -n "$(dnf -q repoquery --available "$pkg" 2>/dev/null)" ]]; then
        echo "$pkg"
    else
        echo "  Note: $pkg isn't in this host's repos, so the bundle won't carry it. A target that lacks xt_addrtype will need it from local media." >&2
    fi
}

# bundled_modules_extra <archive>: the kernel-modules-extra package the archive carries, as kernel-modules-extra-<kernel>,
# or nothing
bundled_modules_extra() {
    local listing
    [[ -f "$1" ]] || return 0
    listing=$(tar -tzf "$1" 2>/dev/null) || return 0
    sed -n 's#^.*/\(kernel-modules-extra-[0-9][^/]*\)\.rpm$#\1#p' <<< "$listing" | tail -n 1
}

ensure_docker_offline() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "  Docker and compose plugin present."
    else
        echo "  Docker missing — installing from bundled offline packages..."
        local off="$BASE_DIR/.offline"
        if [[ -f "$off/offline-packages.tar.gz" && -x "$off/install_packages.sh" ]]; then
            local pkgs
            read -r -a pkgs <<< "$(docker_packages)"
            ( cd "$off" && ./install_packages.sh offline "${pkgs[@]}" )
        else
            echo "Error: offline bundle has no Docker packages and Docker is not installed on this host." >&2
            exit 1
        fi
        command -v docker >/dev/null 2>&1 || { echo "Error: offline Docker install failed." >&2; exit 1; }
    fi
    # Ubuntu's package starts Docker, and the rpm packages don't. Online, images-pull-push starts it. Also on a re-run,
    # after a first run that installed Docker but couldn't start it.
    if systemctl cat docker.service >/dev/null 2>&1 && ! systemctl is-active --quiet docker; then
        check_el_docker_modules_offline
        echo "  Starting Docker..."
        if ! systemctl enable --now docker; then
            echo "Error: Docker is installed but won't start. See 'journalctl -u docker'." >&2
            exit 1
        fi
    fi
}

# Rocky, Alma and RHEL 10 keep the module Docker needs for its NAT rules (xt_addrtype) in kernel-modules-extra, which
# their cloud images leave out, so Docker can't start without it. Online, images-pull-push installs the running
# kernel's package. Here nothing can be fetched: a bundle built on a host running this same kernel carries its package
# (spec 15, F1), and otherwise it says what to do (spec 11, U2).
check_el_docker_modules_offline() {
    case "${ID:-}" in rhel|centos|rocky|almalinux|fedora) ;; *) return 0 ;; esac
    modprobe -n xt_addrtype >/dev/null 2>&1 && return 0
    local kver dir newer="" off="$BASE_DIR/.offline" bundled
    kver=$(uname -r)
    bundled=$(bundled_modules_extra "$off/offline-packages.tar.gz")
    if [[ "$bundled" == "kernel-modules-extra-$kver" && -x "$off/install_packages.sh" ]]; then
        echo "  Installing kernel-modules-extra-$kver from the bundle..."
        if ( cd "$off" && ./install_packages.sh offline "kernel-modules-extra-$kver" ) && modprobe xt_addrtype; then
            echo "  xt_addrtype kernel module loaded."
            return 0
        fi
        echo "Error: kernel-modules-extra-$kver from the bundle didn't give the running kernel xt_addrtype." >&2
        exit 1
    fi
    [[ -n "$bundled" ]] && echo "  The bundle carries $bundled, which is for another kernel: it was built on a host running ${bundled#kernel-modules-extra-}." >&2
    for dir in "${MODULES_ROOT:-/lib/modules}"/*/; do
        dir=${dir%/}
        [[ "${dir##*/}" == "$kver" ]] && continue
        if [[ -n "$(find "$dir" -name 'xt_addrtype.ko*' -print -quit 2>/dev/null)" ]]; then newer=${dir##*/}; fi
    done
    echo "Error: Docker needs the xt_addrtype kernel module, which the running kernel ($kver) doesn't have." >&2
    if [[ -n "$newer" ]]; then
        echo "  Kernel $newer, installed on this host, has it: reboot into it, then run this again." >&2
    else
        echo "  Install kernel-modules-extra-$kver from local media (dnf install kernel-modules-extra-$kver)," >&2
        echo "  then run this again." >&2
    fi
    exit 1
}

# generate_bundle_licenses <stage dir>: LICENSES/ for a save bundle (spec 15, Q9). A manifest of what it redistributes, and a
# written offer for the GPL and LGPL parts: OS packages such as iptables, the kernel's modules on EL and the SELinux
# policy on SUSE, and the Caddy image's Alpine base layer (BusyBox).
generate_bundle_licenses() {
    local dir="$1/LICENSES" pkg_archive="$1/offline-packages.tar.gz" listing="" caddy_ver="$CADDY_VERSION"
    mkdir -p "$dir"
    # With CADDY_VERSION=latest, record the version the image really has
    if [[ "$caddy_ver" == latest ]]; then
        caddy_ver=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$(caddy_runtime_tag)" 2>/dev/null) || caddy_ver=""
        caddy_ver=${caddy_ver:-latest}
    fi
    if [[ -f "$pkg_archive" ]]; then
        listing=$(tar -tzf "$pkg_archive" 2>/dev/null | sed -n 's#^.*/\([^/]*\.\(deb\|rpm\)\)$#  \1#p' | sort) || listing=""
    fi
    cat > "$dir/THIRD_PARTY_NOTICES.txt" <<EOF
Third-party components redistributed in this markdown-server save bundle
Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)

The server image, image/$(image_tar), built from caddy:${CADDY_VERSION} (Caddy ${caddy_ver}):
  Caddy ${caddy_ver} ........................ Apache-2.0   https://github.com/caddyserver/caddy
  caddy-webdav ........................ Apache-2.0   https://github.com/mholt/caddy-webdav
  goldmark ............................ MIT          https://github.com/yuin/goldmark
  github-markdown-css 5.2.0 ........... MIT          https://github.com/sindresorhus/github-markdown-css
