#!/bin/bash
#
# install-md — Markdown Server installer (Chubtoad5)
#
# A Caddy-in-Docker static Markdown site with a folder-hierarchy sidebar.
# Conforms to the Chubtoad5 tooling conventions: runtime env-var overrides,
# distro detection, root requirement, JIT dependency fetch, tri-mode
# online/save/offline, and a per-run log.
#
# Modes: online install (default), `save` (build an air-gap bundle), and
# offline install (auto-detected when md-save.tar.gz is present). The agent
# API and upload UI arrive in later phases; the custom image already bundles
# the caddy-webdav module so those phases only add Caddyfile routes.

set -euo pipefail

SCRIPT_VERSION="1.1.0"
IPP_URL="https://github.com/Chubtoad5/images-pull-push/raw/refs/heads/main/image_pull_push.sh"

### ---- USER DEFINED VARIABLES (all runtime-overridable: sudo VAR=value ./install-md) ----
BASE_DIR="${BASE_DIR:-/opt/caddy-markdown}"           # Install and data directory
SRV_DIR="${SRV_DIR:-$BASE_DIR/srv}"                   # Markdown content directory
MGMT_IP="${MGMT_IP:-$(hostname -I | awk '{print $1}')}"  # Bind IP address
FQDN="${TLS_FQDN:-${FQDN:-md.$(hostname -f 2>/dev/null || hostname)}}"  # FQDN (TLS_FQDN alias accepted)
TCP_PORT="${TCP_PORT:-80}"                            # Listen port (use 443+ with TLS)
TLS_MODE="${TLS_MODE:-none}"                          # none | internal (self-signed) | auto (letsencrypt)
BROWSER_TITLE="${BROWSER_TITLE:-Markdown Server}"     # Browser tab title
CADDY_VERSION="${CADDY_VERSION:-latest}"              # Caddy base image tag (latest -> caddy:builder)
IMG_NAME="${IMG_NAME:-markdown-caddy}"                # Built (xcaddy+webdav) image repo name

# Air-gap / asset settings
OFFLINE_SENTINEL="md-save.tar.gz"                     # Presence in cwd triggers offline mode
WEBDAV_MODULE="github.com/mholt/caddy-webdav"         # Caddy module baked into the custom image
ASSET_CSS_MD="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.2.0/github-markdown-dark.min.css"
ASSET_CSS_HL="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css"
ASSET_JS_HL="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"

LOG_FILE="$(pwd)/md-install.log"

_err() { echo "ERROR: install-md failed at line $1 (exit $2). See ${LOG_FILE} for details." >&2; }
trap '_err "$LINENO" "$?"' ERR

usage() {
    cat <<EOF
install-md — Markdown Server installer (Chubtoad5) v$SCRIPT_VERSION

Usage: sudo [VAR=value ...] ./install-md [command]

Commands:
  install     Install or refresh the Markdown Server (default if omitted).
              Offline install is automatic when ./md-save.tar.gz is present.
  save        Build an air-gap bundle (md-save.tar.gz): custom image + assets
              + Docker packages. Does not deploy.
  uninstall   Stop and remove the stack (backs up content first; MD_PURGE=true to skip)
  status      Show container status and an HTTP health probe
  version     Print installer and Caddy version info
  help        Show this help

Environment variables (override at runtime, e.g. sudo TCP_PORT=8080 ./install-md):
  BASE_DIR        Install/data directory          (default: /opt/caddy-markdown)
  SRV_DIR         Markdown content directory       (default: \$BASE_DIR/srv)
  MGMT_IP         Bind IP address                  (default: first host IP)
  FQDN            Server FQDN (TLS_FQDN alias)      (default: md.\$(hostname -f))
  TCP_PORT        Listen port                      (default: 80)
  TLS_MODE        none | internal | auto           (default: none)
  BROWSER_TITLE   Browser tab title                (default: Markdown Server)
  CADDY_VERSION   Caddy image tag                  (default: latest)
  MD_RESET        true = wipe content on install (backup still taken)   (default: false)
  MD_PURGE        true = skip content backup on uninstall               (default: false)
EOF
}

show_version() {
    echo "install-md (markdown-server) v$SCRIPT_VERSION"
    echo "CADDY_VERSION: $CADDY_VERSION  (image: $(md_image), builder: $(caddy_builder_tag))"
    echo "custom image bundles the caddy-webdav module"
}

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "This script must be run as root." >&2
        exit 1
    fi
}

detect_distro() {
    if [[ ! -r /etc/os-release ]]; then
        echo "Error: /etc/os-release not found; cannot detect OS." >&2
        exit 1
    fi
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}" in
        ubuntu|debian|rhel|centos|rocky|almalinux|fedora|sles|opensuse-leap)
            echo "  Detected supported OS: ${ID} ${VERSION_ID:-}" ;;
        *)
            echo "Error: Unknown or unsupported OS '${ID:-unknown}'." >&2
            exit 1 ;;
    esac
}

port_in_use() {
    local p="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnH "( sport = :$p )" 2>/dev/null | grep -q .
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    else
        return 1  # no probe available; assume free
    fi
}

ensure_docker() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "  Docker and compose plugin present."
        return 0
    fi
    echo "  Docker or compose plugin missing — installing via images-pull-push (conventions §9)..."
    mkdir -p "$BASE_DIR/utilities"
    if [[ ! -x "$BASE_DIR/utilities/image_pull_push.sh" ]]; then
        curl -sfL "$IPP_URL" -o "$BASE_DIR/utilities/image_pull_push.sh"
        chmod +x "$BASE_DIR/utilities/image_pull_push.sh"
    fi
    ( cd "$BASE_DIR/utilities" && ./image_pull_push.sh docker )
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: Docker installation did not complete successfully." >&2
        exit 1
    fi
}

# ---- Image / asset / air-gap helpers ----

is_offline() { [[ -f "$(pwd)/$OFFLINE_SENTINEL" ]]; }

caddy_builder_tag() {
    if [[ "$CADDY_VERSION" == "latest" ]]; then echo "caddy:builder"; else echo "caddy:${CADDY_VERSION}-builder"; fi
}
caddy_runtime_tag() { echo "caddy:${CADDY_VERSION}"; }
md_image()    { echo "${IMG_NAME}:${CADDY_VERSION}"; }
image_tar()   { echo "markdown-caddy-image.tar.gz"; }

generate_dockerfile() {
    cat > "$BASE_DIR/Dockerfile" <<EOF
# Custom Caddy build with the WebDAV module (used by the upload UI + agent writes).
FROM $(caddy_builder_tag) AS builder
RUN xcaddy build --with $WEBDAV_MODULE
FROM $(caddy_runtime_tag)
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
EOF
}

build_image() {
    echo "  Building custom Caddy image $(md_image) (xcaddy + webdav)..."
    generate_dockerfile
    docker build -t "$(md_image)" -f "$BASE_DIR/Dockerfile" "$BASE_DIR"
}

fetch_assets() {
    echo "  Vendoring front-end assets for local (air-gap-safe) serving..."
    mkdir -p "$BASE_DIR/assets"
    curl -sfL "$ASSET_CSS_MD" -o "$BASE_DIR/assets/github-markdown-dark.min.css"
    curl -sfL "$ASSET_CSS_HL" -o "$BASE_DIR/assets/github-dark.min.css"
    curl -sfL "$ASSET_JS_HL"  -o "$BASE_DIR/assets/highlight.min.js"
}

extract_offline_bundle() {
    echo "  Extracting offline bundle ($OFFLINE_SENTINEL)..."
    mkdir -p "$BASE_DIR/.offline"
    rm -rf "$BASE_DIR/.offline"
    mkdir -p "$BASE_DIR/.offline" "$BASE_DIR/assets"
    tar xzf "$(pwd)/$OFFLINE_SENTINEL" -C "$BASE_DIR/.offline"
    cp -a "$BASE_DIR/.offline/assets/." "$BASE_DIR/assets/"
}

ensure_docker_offline() {
    if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "  Docker and compose plugin present."
        return 0
    fi
    echo "  Docker missing — installing from bundled offline packages..."
    local off="$BASE_DIR/.offline"
    if [[ -f "$off/offline-packages.tar.gz" && -x "$off/install_packages.sh" ]]; then
        ( cd "$off" && ./install_packages.sh offline docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin )
    else
        echo "Error: offline bundle has no Docker packages and Docker is not installed on this host." >&2
        exit 1
    fi
    command -v docker >/dev/null 2>&1 || { echo "Error: offline Docker install failed." >&2; exit 1; }
}

load_offline_image() {
    echo "  Loading custom Caddy image from bundle (no pull/build)..."
    gunzip -c "$BASE_DIR/.offline/image/$(image_tar)" | docker load
}

generate_caddyfile() {
    local cfile="$BASE_DIR/Caddyfile"
    local site
    if [[ "$TLS_MODE" == "none" ]]; then
        echo "  Configuring HTTP on port $TCP_PORT (any host — IP, hostname, or FQDN all work)"
        site=":$TCP_PORT"
        : > "$cfile"
    elif [[ "$TLS_MODE" == "internal" ]]; then
        echo "  Configuring HTTPS (self-signed) on port $TCP_PORT for IP $MGMT_IP and FQDN $FQDN"
        printf '{\n  default_sni %s\n}\n' "$MGMT_IP" > "$cfile"
        site="https://$MGMT_IP:$TCP_PORT https://$FQDN:$TCP_PORT"
    else
        echo "  Configuring HTTPS (Let's Encrypt) on port $TCP_PORT for FQDN $FQDN"
        echo "  NOTE: TLS_MODE=auto needs a public, resolvable FQDN; IP-only access is not possible with Let's Encrypt."
        site="$FQDN:$TCP_PORT"
        : > "$cfile"
    fi

    {
        echo "$site {"
        [[ "$TLS_MODE" == "internal" ]] && echo "    tls internal"
        cat <<'ROUTES'
    root * /srv

    # Vendored CSS/JS, served locally so the page renders fully offline.
    handle /_assets/* {
        root * /assets
        uri strip_prefix /_assets
        file_server
    }

    # Rendered Markdown site (folder sidebar + GitHub theme).
    handle {
        templates
        @markdown_site path / *.md
        rewrite @markdown_site /layout.html
        file_server
    }
}
ROUTES
    } >> "$cfile"
}

generate_layout() {
    cat > "$SRV_DIR/layout.html" <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>$BROWSER_TITLE</title>
    <link rel="stylesheet" href="/_assets/github-markdown-dark.min.css">
    <link rel="stylesheet" href="/_assets/github-dark.min.css">
    <style>
        :root {
            --sidebar-bg: #0d1117;
            --content-bg: #161b22;
            --code-bg: #0d1117;
            --text-main: #c9d1d9;
            --accent: #58a6ff;
            --sidebar-border: #30363d;
            --link-color: #8b949e;
            --sidebar-width: 195px;
        }

        body {
            display: flex; margin: 0; height: 100vh; overflow: hidden;
            font-family: -apple-system, system-ui, sans-serif;
            background-color: var(--content-bg); color: var(--text-main);
        }

        nav {
            width: var(--sidebar-width); min-width: 120px; max-width: 50vw;
            box-sizing: border-box; background-color: var(--sidebar-bg);
            border-right: 1px solid var(--sidebar-border);
            padding: 25px 15px; overflow-y: auto; flex-shrink: 0;
        }

        nav h3 { font-size: 10px; color: #8b949e; text-transform: uppercase; margin-bottom: 15px; letter-spacing: 1px; }
        nav ul { list-style: none; padding: 0; margin: 0; }
        nav li { margin-bottom: 4px; }

        nav a {
            display: block; padding: 10px 12px; font-size: 13px;
            color: var(--link-color) !important; text-decoration: none !important;
            border-radius: 6px; white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis; min-height: 1.2em;
        }

        nav a:hover { background-color: #21262d; color: var(--accent) !important; }
        nav a.active { background-color: #1f6feb; color: #ffffff !important; font-weight: 600; }

        /* Folder styles */
        .folder-toggle {
            display: flex; align-items: center; padding: 10px 12px; font-size: 13px;
            color: var(--link-color); cursor: pointer; border-radius: 6px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            user-select: none; font-weight: 600;
        }
        .folder-toggle:hover { background-color: #21262d; color: var(--accent); }
        .folder-toggle::before {
            content: '\25B6'; display: inline-block; margin-right: 8px; font-size: 9px;
            transition: transform 0.2s ease; flex-shrink: 0;
        }
        .folder.expanded > .folder-toggle::before { transform: rotate(90deg); }
        .folder-contents { display: none; padding-left: 12px; }
        .folder.expanded > .folder-contents { display: block; }

        /* Resize handle */
        .resize-handle {
            width: 5px; cursor: col-resize; background-color: transparent;
            flex-shrink: 0; transition: background-color 0.15s;
        }
        .resize-handle:hover, .resize-handle.active { background-color: var(--accent); }

        main { flex-grow: 1; overflow-y: auto; background-color: var(--content-bg); }
        .markdown-body { box-sizing: border-box; width: 100%; max-width: 100%; padding: 50px; background-color: transparent !important; }

        .markdown-body pre { position: relative; background-color: var(--code-bg) !important; border: 1px solid #30363d !important; border-radius: 8px; padding: 16px; }

        .copy-code-button { position: absolute; top: 10px; right: 10px; padding: 4px 8px; background-color: #21262d; color: #8b949e; border: 1px solid #30363d; border-radius: 6px; font-size: 11px; cursor: pointer; opacity: 0; transition: opacity 0.2s; z-index: 10; }
        pre:hover .copy-code-button { opacity: 1; }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--sidebar-bg); }
        ::-webkit-scrollbar-thumb { background: #30363d; border-radius: 10px; }
    </style>
</head>
<body>

<nav id="sidebar">
  <h3>Navigation</h3>
  <ul>
    <li>
      <a href="/"
         class="{{ if or (eq .OriginalReq.URL.Path "/") (eq .OriginalReq.URL.Path "") }}active{{ end }}">
        Home
      </a>
    </li>

    {{/* 1) Collect root-level markdown files */}}
    {{ \$rootFiles := list }}
    {{ range listFiles "/" }}
      {{ if and (hasSuffix ".md" .) (ne . "index.md") (ne . "layout.html") }}
        {{ \$rootFiles = append \$rootFiles . }}
      {{ end }}
    {{ end }}

    {{/* 2) Render sorted root-level files */}}
    {{ range sortAlpha \$rootFiles }}
      <li>
        <a href="/{{ . }}"
           class="{{ if eq $.OriginalReq.URL.Path (printf "/%s" .) }}active{{ end }}">
          {{ . | trimSuffix ".md" | replace "-" " " }}
        </a>
      </li>
    {{ end }}

    {{/* 3) Collect subdirectories (non .md, non .html, non hidden entries) */}}
    {{ \$dirs := list }}
    {{ range listFiles "/" }}
      {{ if and (not (hasSuffix ".md" .)) (not (hasSuffix ".html" .)) (not (hasPrefix "." .)) }}
        {{ \$dirs = append \$dirs . }}
      {{ end }}
    {{ end }}

    {{/* 4) Render sorted directories with their markdown files */}}
    {{ range sortAlpha \$dirs }}
      {{ \$dirName := . }}
      {{ \$dirFiles := list }}
      {{ range listFiles (printf "/%s" \$dirName) }}
        {{ if hasSuffix ".md" . }}
          {{ \$dirFiles = append \$dirFiles . }}
        {{ end }}
      {{ end }}
      {{ if \$dirFiles }}
        {{ \$hasActive := false }}
        {{ range sortAlpha \$dirFiles }}
          {{ if eq $.OriginalReq.URL.Path (printf "/%s/%s" \$dirName .) }}
            {{ \$hasActive = true }}
          {{ end }}
        {{ end }}
        <li class="folder{{ if \$hasActive }} expanded{{ end }}">
          <div class="folder-toggle">{{ \$dirName | replace "-" " " }}</div>
          <ul class="folder-contents">
            {{ range sortAlpha \$dirFiles }}
              <li>
                <a href="/{{ \$dirName }}/{{ . }}"
                   class="{{ if eq $.OriginalReq.URL.Path (printf "/%s/%s" \$dirName .) }}active{{ end }}">
                  {{ . | trimSuffix ".md" | replace "-" " " }}
                </a>
              </li>
            {{ end }}
          </ul>
        </li>
      {{ end }}
    {{ end }}

  </ul>
</nav>

<div class="resize-handle" id="resizeHandle"></div>

<main>
    <article class="markdown-body">
        {{\$req := .OriginalReq.URL.Path}}
        {{if or (eq \$req "/") (eq \$req "")}}
            {{markdown (readFile "index.md")}}
        {{else}}
            {{markdown (readFile \$req)}}
        {{end}}
    </article>
</main>

<script src="/_assets/highlight.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        hljs.highlightAll();

        // Copy code button
        document.querySelectorAll('pre').forEach((codeBlock) => {
            const button = document.createElement('button');
            button.className = 'copy-code-button';
            button.innerText = 'Copy';
            button.addEventListener('click', () => {
                const text = codeBlock.querySelector('code').innerText;
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    button.innerText = 'Copied!';
                } catch (err) { button.innerText = 'Error'; }
                document.body.removeChild(textArea);
                setTimeout(() => { button.innerText = 'Copy'; }, 2000);
            });
            codeBlock.appendChild(button);
        });

        // Folder expand/collapse toggle
        document.querySelectorAll('.folder-toggle').forEach((toggle) => {
            toggle.addEventListener('click', () => {
                toggle.parentElement.classList.toggle('expanded');
            });
        });

        // Sidebar resize with mouse drag
        const sidebar = document.getElementById('sidebar');
        const handle = document.getElementById('resizeHandle');
        let isResizing = false;

        // Restore saved sidebar width
        const savedWidth = localStorage.getItem('mdSidebarWidth');
        if (savedWidth) {
            const w = parseInt(savedWidth, 10);
            if (w >= 120 && w <= window.innerWidth * 0.5) {
                sidebar.style.width = w + 'px';
            }
        }

        handle.addEventListener('mousedown', (e) => {
            isResizing = true;
            handle.classList.add('active');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isResizing) return;
            const newWidth = e.clientX;
            if (newWidth >= 120 && newWidth <= window.innerWidth * 0.5) {
                sidebar.style.width = newWidth + 'px';
            }
        });

        document.addEventListener('mouseup', () => {
            if (isResizing) {
                isResizing = false;
                handle.classList.remove('active');
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                localStorage.setItem('mdSidebarWidth', sidebar.offsetWidth);
            }
        });
    });
</script>
</body>
</html>
EOF
}

generate_demo_content() {
    cat > "$SRV_DIR/index.md" <<EOF
# Home Page
This is the index.md file, which will always be at the top of the navigation sidebar.

## How to add Markdown pages to this site
- Generate a markdown (.md) file
- Files will be sorted alpha numericly based on file namne on the navigation page
- Use number prefixes to sort, i.e. "01-first-file.md, 02-second-file.md, etc..."
- Use valid markdown formatting
- Login to this host
- Create a new or copy your .md file into \`/opt/caddy-markdown/srv\` directory
- Save the file, then refresh the page

## Folder Hierarchy
You can organize markdown files into subdirectories for better structure:
- Create a subdirectory inside \`/opt/caddy-markdown/srv\` (e.g. \`tutorials/\`)
- Place \`.md\` files inside the subdirectory
- Folders appear in the sidebar and can be expanded or collapsed by clicking on them
- The sidebar is resizable by dragging its right edge
- Root-level \`.md\` files continue to appear as a flat list above any folders

## Table For Reference
| Topic | Link | Note |
|:---------|:---------|:---------|
| First Topic   | [link](01-first-topic.md)   | Introduction to the docs   |
| Copy Test   | [link](Copy-test.md)   | Discover the copy feature   |
| Next Topic   | [link](next-topic-with-a-long-name.md)   | Testing long file names   |
| Tutorial: Getting Started   | [link](tutorials/getting-started.md)   | A page inside a folder   |

EOF

    cat > "$SRV_DIR/01-first-topic.md" <<EOF
# First Topic
Markdown files are sorted alphabetically in the sidebar. You can prefix file names with numbers to control the order.
Here is a sample link:
[To the next topic](Copy-test.md)
[Back to Home](/)
EOF

    cat > "$SRV_DIR/Copy-test.md" <<EOF
# Copy Test
Supports github style code blocks with built in copy button. Test out the copy feature from the below code block:
\`\`\`
echo "Hello World!"
\`\`\`
[Back to Home](/)
EOF

    cat > "$SRV_DIR/next-topic-with-a-long-name.md" <<EOF
# Next Topic
This file is called \`next-topic-with-a-long-name.md\` to show that dashes are replaced with spaces in the sidebar links.
Headings are also title cased automatically.
You can also use longer file names to test text overflow handling in the sidebar links.
[Back to Home](/)
EOF

    mkdir -p "$SRV_DIR/tutorials"

    cat > "$SRV_DIR/tutorials/getting-started.md" <<EOF
# Getting Started
This page lives inside the \`tutorials/\` subdirectory.

Folders appear in the sidebar as collapsible sections. Click the folder name to expand or collapse it.

## Next Steps
- Try creating your own subdirectory under \`/opt/caddy-markdown/srv\`
- Add \`.md\` files to it and refresh the page

[Back to Home](/)
EOF

    cat > "$SRV_DIR/tutorials/advanced-config.md" <<EOF
# Advanced Configuration
This is another page inside the \`tutorials/\` folder, demonstrating that multiple files within a subdirectory are listed alphabetically.

## Tips
- Prefix file names with numbers to control sort order (e.g. \`01-setup.md\`, \`02-usage.md\`)
- Dashes in file names are displayed as spaces in the sidebar
- The sidebar can be resized by dragging its right edge

[Back to Home](/)
EOF
}

generate_compose() {
    cat > "$BASE_DIR/docker-compose.yml" <<EOF
services:
  caddy:
    image: $(md_image)
    pull_policy: never
    ports:
      - "$TCP_PORT:$TCP_PORT"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - ./srv:/srv
      - ./assets:/assets
    restart: unless-stopped
EOF
}

write_install_env() {
    cat > "$BASE_DIR/.install-env" <<EOF
# Generated by install-md v$SCRIPT_VERSION on $(date)
BASE_DIR="$BASE_DIR"
SRV_DIR="$SRV_DIR"
TCP_PORT="$TCP_PORT"
TLS_MODE="$TLS_MODE"
FQDN="$FQDN"
MGMT_IP="$MGMT_IP"
CADDY_VERSION="$CADDY_VERSION"
IMG="$(md_image)"
EOF
}

print_access() {
    local scheme="http"
    [[ "$TLS_MODE" != "none" ]] && scheme="https"
    echo
    echo "Setup complete! Navigate to:"
    echo "    $scheme://$MGMT_IP:$TCP_PORT"
    echo "    $scheme://$FQDN:$TCP_PORT"
}

do_install() {
    : > "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/md-install.log"
    exec > >(tee -a "$LOG_FILE") 2>&1

    echo "### - Starting Markdown Server installation - $(date) ###"
    detect_distro
    mkdir -p "$BASE_DIR"

    local offline=false
    if is_offline; then
        offline=true
        echo "  Offline bundle ($OFFLINE_SENTINEL) detected — installing without internet."
        extract_offline_bundle
        ensure_docker_offline
    else
        ensure_docker
    fi

    # Stop any existing stack first so the port frees up before we probe it.
    if [[ -f "$BASE_DIR/docker-compose.yml" ]]; then
        echo "  Stopping existing Markdown Server stack..."
        docker compose -f "$BASE_DIR/docker-compose.yml" down >/dev/null 2>&1 || true
    fi

    if port_in_use "$TCP_PORT"; then
        echo "Error: TCP port $TCP_PORT is already in use. Set TCP_PORT=<free port> or free the port." >&2
        exit 1
    fi

    # Obtain the custom Caddy image: build it online, or load it from the bundle offline.
    if [[ "$offline" == true ]]; then
        load_offline_image
    else
        build_image
        fetch_assets
    fi

    # Preserve existing user content (never silently destroy markdown files).
    local preserve=false
    if [[ -d "$SRV_DIR" && -n "$(ls -A "$SRV_DIR" 2>/dev/null)" ]]; then
        local backup
        backup="$(dirname "$BASE_DIR")/md-srv-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
        echo "  Backing up existing content ($SRV_DIR) -> $backup"
        tar czf "$backup" -C "$SRV_DIR" .
        preserve=true
        if [[ "${MD_RESET:-false}" == "true" ]]; then
            echo "  MD_RESET=true -> wiping existing content (backup retained at $backup)"
            rm -rf "$SRV_DIR"
            preserve=false
        fi
    fi

    mkdir -p "$SRV_DIR"
    echo "  Generating Caddyfile..."
    generate_caddyfile
    echo "  Generating layout.html..."
    generate_layout
    echo "  Generating docker-compose.yml..."
    generate_compose
    if [[ "$preserve" == true ]]; then
        echo "  Preserving existing markdown content (skipping demo files)."
    else
        echo "  Generating example Markdown files..."
        generate_demo_content
    fi
    write_install_env

    echo "  Starting docker compose..."
    ( cd "$BASE_DIR" && docker compose up -d )

    echo "### - Markdown Server installation finished - $(date) ###"
    print_access
}

do_uninstall() {
    : > "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/md-install.log"
    exec > >(tee -a "$LOG_FILE") 2>&1

    # Recover install-time paths (SRV_DIR etc.) so teardown matches the install.
    # shellcheck disable=SC1091
    [[ -f "$BASE_DIR/.install-env" ]] && . "$BASE_DIR/.install-env"
    echo "### - Uninstalling Markdown Server - $(date) ###"
    if [[ -f "$BASE_DIR/docker-compose.yml" ]]; then
        docker compose -f "$BASE_DIR/docker-compose.yml" down >/dev/null 2>&1 || true
    fi
    # Remove the locally built/loaded image (rebuilt or reloaded on next install).
    if [[ -n "${IMG:-}" ]]; then
        docker rmi "$IMG" >/dev/null 2>&1 || true
    fi
    if [[ "${MD_PURGE:-false}" != "true" && -d "$SRV_DIR" && -n "$(ls -A "$SRV_DIR" 2>/dev/null)" ]]; then
        local backup
        backup="$(dirname "$BASE_DIR")/md-srv-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
        echo "  Backing up content before removal -> $backup"
        tar czf "$backup" -C "$SRV_DIR" .
        echo "  (set MD_PURGE=true to skip this backup)"
    fi
    rm -rf "$BASE_DIR"
    echo "### - Markdown Server uninstalled - $(date) ###"
}

do_save() {
    : > "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/md-install.log"
    exec > >(tee -a "$LOG_FILE") 2>&1

    echo "### - Building Markdown Server offline bundle - $(date) ###"
    detect_distro
    ensure_docker
    mkdir -p "$BASE_DIR"
    build_image
    fetch_assets

    local stage="$BASE_DIR/.save"
    rm -rf "$stage"
    mkdir -p "$stage/image" "$stage/assets"

    echo "  Saving image $(md_image)..."
    docker save "$(md_image)" | gzip > "$stage/image/$(image_tar)"
    cp -a "$BASE_DIR/assets/." "$stage/assets/"

    echo "  Bundling Docker packages for offline install (install-packages save)..."
    mkdir -p "$BASE_DIR/utilities"
    if [[ ! -x "$BASE_DIR/utilities/install_packages.sh" ]]; then
        curl -sfL "https://github.com/Chubtoad5/install-packages/raw/refs/heads/main/install_packages.sh" \
            -o "$BASE_DIR/utilities/install_packages.sh"
        chmod +x "$BASE_DIR/utilities/install_packages.sh"
    fi
    cp "$BASE_DIR/utilities/install_packages.sh" "$stage/install_packages.sh"
    if ( cd "$stage" && ./install_packages.sh save docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin ); then
        echo "  Docker packages bundled (offline-packages.tar.gz)."
    else
        echo "  WARNING: Docker package save failed; offline install will require Docker pre-installed on the target." >&2
    fi

    cat > "$stage/save-manifest.txt" <<EOF
image=$(md_image)
caddy_version=$CADDY_VERSION
built=$(date)
os=${ID:-unknown} ${VERSION_ID:-}
EOF

    local out="$(pwd)/$OFFLINE_SENTINEL"
    echo "  Creating $out ..."
    tar czf "$out" -C "$stage" .
    rm -rf "$stage"
    echo "### - Offline bundle ready: $out - $(date) ###"
    echo "  NOTE: the bundle is OS-family/version specific (Docker packages)."
    echo "  Transfer it to the target host's working directory and run:  sudo ./install-md install"
}

do_status() {
    if [[ ! -f "$BASE_DIR/docker-compose.yml" ]]; then
        echo "Markdown Server is not installed at $BASE_DIR."
        exit 1
    fi
    # Recover install-time settings (port, TLS mode) for an accurate probe.
    # shellcheck disable=SC1091
    [[ -f "$BASE_DIR/.install-env" ]] && . "$BASE_DIR/.install-env"
    docker compose -f "$BASE_DIR/docker-compose.yml" ps
    local scheme="http"
    [[ "$TLS_MODE" != "none" ]] && scheme="https"
    # Probe via MGMT_IP (a configured site address); localhost would not match
    # the host-scoped site blocks and would return an empty 200.
    local code
    code="$(curl -sk -o /dev/null -w '%{http_code}' "$scheme://$MGMT_IP:$TCP_PORT/" 2>/dev/null || echo 000)"
    echo "HTTP probe ($scheme://$MGMT_IP:$TCP_PORT/): $code"
}

### ---- Dispatch ----
CMD="${1:-install}"
case "$CMD" in
    help|-h|--help) usage; exit 0 ;;
    version|--version) show_version; exit 0 ;;
esac

require_root
case "$CMD" in
    install)   do_install ;;
    save)      do_save ;;
    uninstall) do_uninstall ;;
    status)    do_status ;;
    *) echo "Unknown command: $CMD" >&2; echo; usage; exit 1 ;;
esac
