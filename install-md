{{ define "navtree" }}
  {{ \$dir := .dir }}{{ \$depth := .depth }}{{ \$max := .max }}{{ \$req := .req }}
  {{/* displayable direct children: .md files (not the root index.md) + dotless subfolders */}}
  {{ \$entries := list }}
  {{ range listFiles \$dir }}
    {{ if and (hasSuffix ".md" .) (not (and (eq \$dir "/") (eq . "index.md"))) }}
      {{ \$entries = append \$entries . }}
    {{ else if and (not (hasPrefix "." .)) (not (contains "." .)) }}
      {{ \$entries = append \$entries . }}
    {{ end }}
  {{ end }}
  {{/* optional per-folder .order manifest (one child name per line); hidden dotfile,
       written by the /admin Organize card via WebDAV. Guarded so a missing file
       never aborts the render. */}}
  {{ \$rel := trimPrefix "/" \$dir }}
  {{ \$orderPath := ".order" }}
  {{ if ne \$rel "" }}{{ \$orderPath = printf "%s/.order" \$rel }}{{ end }}
  {{ \$manifest := list }}
  {{ if has ".order" (listFiles \$dir) }}
    {{ range splitList "\n" (readFile \$orderPath) }}
      {{ \$line := trim . }}
      {{ if ne \$line "" }}{{ \$manifest = append \$manifest \$line }}{{ end }}
    {{ end }}
  {{ end }}
  {{/* manifest entries first (still on disk, de-duped, in order), then anything new
       alpha-sorted at the bottom. No manifest -> index.md / README.md pinned to top. */}}
  {{ \$ordered := list }}
  {{ range \$manifest }}
    {{ if and (has . \$entries) (not (has . \$ordered)) }}{{ \$ordered = append \$ordered . }}{{ end }}
  {{ end }}
  {{ \$leftovers := list }}
  {{ range \$entries }}
    {{ if not (has . \$ordered) }}{{ \$leftovers = append \$leftovers . }}{{ end }}
  {{ end }}
  {{ \$leftovers = sortAlpha \$leftovers }}
  {{ if not \$manifest }}
    {{ \$pinned := list }}
    {{ if has "index.md" \$leftovers }}{{ \$pinned = append \$pinned "index.md" }}{{ end }}
    {{ if has "README.md" \$leftovers }}{{ \$pinned = append \$pinned "README.md" }}{{ end }}
    {{ \$rest := list }}
    {{ range \$leftovers }}{{ if not (has . \$pinned) }}{{ \$rest = append \$rest . }}{{ end }}{{ end }}
    {{ \$leftovers = concat \$pinned \$rest }}
  {{ end }}
  {{ \$final := concat \$ordered \$leftovers }}
  {{ range \$final }}
    {{ if hasSuffix ".md" . }}
      {{ \$href := printf "%s/%s" (trimSuffix "/" \$dir) . }}
      <li><a href="{{ \$href }}" class="{{ if eq \$req \$href }}active{{ end }}">{{ . | trimSuffix ".md" | replace "-" " " }}</a></li>
    {{ else }}
      {{ \$child := printf "%s/%s" (trimSuffix "/" \$dir) . }}
      {{ if lt \$depth \$max }}
        {{ \$open := hasPrefix (printf "%s/" \$child) \$req }}
        <li class="folder{{ if \$open }} expanded{{ end }}">
          <div class="folder-toggle">{{ . | replace "-" " " }}</div>
          <ul class="folder-contents">
            {{ template "navtree" (dict "dir" \$child "depth" (add \$depth 1) "max" \$max "req" \$req) }}
          </ul>
        </li>
      {{ else }}
        <li><span class="depth-limit">&#9888; {{ . | replace "-" " " }} (nested beyond {{ \$max }} levels) not shown</span></li>
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
<nav id="sidebar">
$admin_nav
  <h3>Navigation</h3>
  <ul>
    {{ \$req := \$.OriginalReq.URL.Path }}
    <li><a href="/" class="{{ if or (eq \$req "/") (eq \$req "") }}active{{ end }}">Home</a></li>
    {{ template "navtree" (dict "dir" "/" "depth" 1 "max" $MAX_FOLDER_DEPTH "req" \$req) }}
  </ul>
</nav>

<div class="resize-handle" id="resizeHandle"></div>

<main>
    <article class="markdown-body">
        {{\$req := .OriginalReq.URL.Path}}
        {{if or (eq \$req "/") (eq \$req "")}}
            {{markdown (readFile "index.md")}}
        {{else}}
            {{markdown (readFile \$req)}}
        {{end}}
