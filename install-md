generate_compose() {
    local img pull_policy
    img="$(runtime_image)"
    # Registry image -> allow a pull; local-only build -> never reach out.
    if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then
        pull_policy="missing"
    else
        pull_policy="never"
    fi
    # No ./assets mount: assets are baked into the image (portable + offline-safe).
    cat > "$BASE_DIR/docker-compose.yml" <<EOF
services:
  caddy:
    image: $img
    pull_policy: $pull_policy
    ports:
      - "$TCP_PORT:$TCP_PORT"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - ./srv:/srv
    restart: unless-stopped
EOF
}

write_install_env() {
    cat > "$BASE_DIR/.install-env" <<EOF
# Generated by install-md v$SCRIPT_VERSION on $(date)
BASE_DIR="$BASE_DIR"
SRV_DIR="$SRV_DIR"
TCP_PORT="$TCP_PORT"
TLS_MODE="$TLS_MODE"
FQDN="$FQDN"
MGMT_IP="$MGMT_IP"
CADDY_VERSION="$CADDY_VERSION"
IMG="$(runtime_image)"
REGISTRY_MODE="$REGISTRY_MODE"
PUSH_MODE="$PUSH_MODE"
AUTH_MODE="$AUTH_MODE"
ENABLE_WEBDAV="$ENABLE_WEBDAV"
EOF
}

print_access() {
    local scheme="http"
    [[ "$TLS_MODE" != "none" ]] && scheme="https"
    echo
    echo "Setup complete! Navigate to:"
    echo "    $scheme://$MGMT_IP:$TCP_PORT"
    echo "    $scheme://$FQDN:$TCP_PORT"
    if [[ "$ENABLE_WEBDAV" == "true" ]]; then
        echo "  Upload / manage UI:  $scheme://$MGMT_IP:$TCP_PORT/admin"
        case "$AUTH_MODE" in
            basic) echo "    auth: basic  (user: $MD_ADMIN_USER  pass: $MD_ADMIN_PASSWORD)  — change MD_ADMIN_PASSWORD!" ;;
            none)  echo "    auth: NONE — /admin and /dav are unauthenticated (risky)" ;;
            forward) echo "    auth: forward_auth -> $FORWARD_AUTH_URL" ;;
        esac
    fi
}

do_install() {
    : > "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/md-install.log"
    exec > >(tee -a "$LOG_FILE") 2>&1

    echo "### - Starting Markdown Server installation - $(date) ###"
    detect_distro
    mkdir -p "$BASE_DIR"

    local offline=false
    if is_offline; then
        offline=true
        echo "  Offline bundle ($OFFLINE_SENTINEL) detected — installing without internet."
        extract_offline_bundle
        ensure_docker_offline
    else
        ensure_docker
    fi

    # Stop any existing stack first so the port frees up before we probe it.
    if [[ -f "$BASE_DIR/docker-compose.yml" ]]; then
        echo "  Stopping existing Markdown Server stack..."
        docker compose -f "$BASE_DIR/docker-compose.yml" down >/dev/null 2>&1 || true
    fi

    if port_in_use "$TCP_PORT"; then
        echo "Error: TCP port $TCP_PORT is already in use. Set TCP_PORT=<free port> or free the port." >&2
        exit 1
    fi

    # Obtain the runtime image, by mode:
    #   registry pull (registry, no push) -> pull from the registry, skip the build
    #   offline bundle                    -> load from md-save.tar.gz
    #   push / plain online               -> build locally (assets baked in)
    if [[ $REGISTRY_MODE -eq 1 && $PUSH_MODE -eq 0 ]]; then
        echo "  Registry mode (no push): pulling $(registry_image_ref) — skipping build."
        ensure_reg_cert
        registry_login
        docker pull "$(registry_image_ref)"
    elif [[ "$offline" == true ]]; then
        load_offline_image
    else
        build_image
    fi

    # Push the freshly built/loaded image to the private registry, if requested.
    if [[ $PUSH_MODE -eq 1 ]]; then
        ensure_reg_cert
        registry_login
        push_image
    fi

    # Hash the admin password using the runtime image's caddy binary (basic auth only).
    if [[ "$ENABLE_WEBDAV" == "true" && "$AUTH_MODE" == "basic" ]]; then
        echo "  Hashing admin password..."
        ADMIN_HASH="$(docker run --rm "$(runtime_image)" caddy hash-password --plaintext "$MD_ADMIN_PASSWORD")"
    fi

    # Preserve existing user content (never silently destroy markdown files).
    local preserve=false
    if [[ -d "$SRV_DIR" && -n "$(ls -A "$SRV_DIR" 2>/dev/null)" ]]; then
        local backup
        backup="$(dirname "$BASE_DIR")/md-srv-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
        echo "  Backing up existing content ($SRV_DIR) -> $backup"
        tar czf "$backup" -C "$SRV_DIR" .
        preserve=true
        if [[ "${MD_RESET:-false}" == "true" ]]; then
            echo "  MD_RESET=true -> wiping existing content (backup retained at $backup)"
            rm -rf "$SRV_DIR"
            preserve=false
        fi
    fi

    mkdir -p "$SRV_DIR"
    echo "  Generating Caddyfile..."
    generate_caddyfile
    echo "  Generating layout.html..."
    generate_layout
    echo "  Generating API file-index template..."
    generate_api_template
    if [[ "$ENABLE_WEBDAV" == "true" ]]; then
        echo "  Generating admin UI..."
        generate_admin_ui
    fi
    echo "  Generating docker-compose.yml..."
    generate_compose
    if [[ "$preserve" == true ]]; then
        echo "  Preserving existing markdown content (skipping demo files)."
    else
        echo "  Generating example Markdown files..."
        generate_demo_content
    fi
    write_install_env

    echo "  Starting docker compose..."
    ( cd "$BASE_DIR" && docker compose up -d )

    echo "### - Markdown Server installation finished - $(date) ###"
    print_access
}

do_uninstall() {
    : > "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/md-install.log"
    exec > >(tee -a "$LOG_FILE") 2>&1

    # Recover install-time paths (SRV_DIR etc.) so teardown matches the install.
    # shellcheck disable=SC1091
    [[ -f "$BASE_DIR/.install-env" ]] && . "$BASE_DIR/.install-env"
    echo "### - Uninstalling Markdown Server - $(date) ###"
    if [[ -f "$BASE_DIR/docker-compose.yml" ]]; then
        docker compose -f "$BASE_DIR/docker-compose.yml" down >/dev/null 2>&1 || true
    fi
    # Remove the locally built/loaded image (rebuilt or reloaded on next install).
    if [[ -n "${IMG:-}" ]]; then
        docker rmi "$IMG" >/dev/null 2>&1 || true
    fi
    if [[ "${MD_PURGE:-false}" != "true" && -d "$SRV_DIR" && -n "$(ls -A "$SRV_DIR" 2>/dev/null)" ]]; then
        local backup
        backup="$(dirname "$BASE_DIR")/md-srv-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
        echo "  Backing up content before removal -> $backup"
        tar czf "$backup" -C "$SRV_DIR" .
        echo "  (set MD_PURGE=true to skip this backup)"
    fi
    rm -rf "$BASE_DIR"
    echo "### - Markdown Server uninstalled - $(date) ###"
}

do_save() {
    : > "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/md-install.log"
    exec > >(tee -a "$LOG_FILE") 2>&1

    echo "### - Building Markdown Server offline bundle - $(date) ###"
    detect_distro
    ensure_docker
    mkdir -p "$BASE_DIR"
    build_image   # assets are vendored + baked into the image

    local stage="$BASE_DIR/.save"
    rm -rf "$stage"
    mkdir -p "$stage/image"

    echo "  Saving image $(md_image)..."
    docker save "$(md_image)" | gzip > "$stage/image/$(image_tar)"

    echo "  Bundling Docker packages for offline install (install-packages save)..."
    mkdir -p "$BASE_DIR/utilities"
    if [[ ! -x "$BASE_DIR/utilities/install_packages.sh" ]]; then
        curl -sfL "https://github.com/Chubtoad5/install-packages/raw/refs/heads/main/install_packages.sh" \
            -o "$BASE_DIR/utilities/install_packages.sh"
        chmod +x "$BASE_DIR/utilities/install_packages.sh"
    fi
    cp "$BASE_DIR/utilities/install_packages.sh" "$stage/install_packages.sh"
    if ( cd "$stage" && ./install_packages.sh save docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin ); then
        echo "  Docker packages bundled (offline-packages.tar.gz)."
    else
        echo "  WARNING: Docker package save failed; offline install will require Docker pre-installed on the target." >&2
    fi

    cat > "$stage/save-manifest.txt" <<EOF
image=$(md_image)
caddy_version=$CADDY_VERSION
built=$(date)
os=${ID:-unknown} ${VERSION_ID:-}
EOF

    local out="$(pwd)/$OFFLINE_SENTINEL"
    echo "  Creating $out ..."
    tar czf "$out" -C "$stage" .
    rm -rf "$stage"
    echo "### - Offline bundle ready: $out - $(date) ###"
    echo "  NOTE: the bundle is OS-family/version specific (Docker packages)."
    echo "  Transfer it to the target host's working directory and run:  sudo ./install-md install"

    # `save push` also pushes the freshly built image to the private registry.
    if [[ $PUSH_MODE -eq 1 ]]; then
        echo "### - Pushing image to registry ($REG_FQDN:$REG_PORT) - $(date) ###"
        ensure_reg_cert
        registry_login
        push_image
    fi
}

do_status() {
    if [[ ! -f "$BASE_DIR/docker-compose.yml" ]]; then
        echo "Markdown Server is not installed at $BASE_DIR."
        exit 1
    fi
    # Recover install-time settings (port, TLS mode) for an accurate probe.
    # shellcheck disable=SC1091
    [[ -f "$BASE_DIR/.install-env" ]] && . "$BASE_DIR/.install-env"
    docker compose -f "$BASE_DIR/docker-compose.yml" ps
    local scheme="http"
    [[ "$TLS_MODE" != "none" ]] && scheme="https"
    # Probe via MGMT_IP (a configured site address); localhost would not match
    # the host-scoped site blocks and would return an empty 200.
    local code
    code="$(curl -sk -o /dev/null -w '%{http_code}' "$scheme://$MGMT_IP:$TCP_PORT/" 2>/dev/null || echo 000)"
    echo "HTTP probe ($scheme://$MGMT_IP:$TCP_PORT/): $code"
}

### ---- Argument parsing ----
# Shape:  ./install-md [command] [push] [-registry <host:port> <user> <pass>]
# The command is the first token unless it is a flag or `push` (then: install).
CMD="install"
if [[ $# -gt 0 && "$1" != -* && "$1" != "push" ]]; then
    CMD="$1"; shift
fi

case "$CMD" in
    help|-h|--help) usage; exit 0 ;;
    version|--version) show_version; exit 0 ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        push)
            PUSH_MODE=1; shift ;;
        -registry)
            REGISTRY_INFO="${2:-}"; REG_USER="${3:-}"; REG_PASS="${4:-}"
            if [[ -z "$REGISTRY_INFO" || -z "$REG_USER" || -z "$REG_PASS" ]]; then
                echo "Error: -registry requires <host:port> <username> <password>." >&2
                echo; usage; exit 1
            fi
            shift 4 ;;
        *)
            echo "Error: unknown argument '$1'." >&2; echo; usage; exit 1 ;;
    esac
done

# A registry supplied by env-var (REGISTRY_INFO) also enables registry mode.
[[ -n "$REGISTRY_INFO" ]] && REGISTRY_MODE=1

### ---- Registry validation ----
if [[ $PUSH_MODE -eq 1 && $REGISTRY_MODE -eq 0 ]]; then
    echo "Error: 'push' requires a registry (-registry <host:port> <user> <pass> or REGISTRY_INFO env-var)." >&2
    echo; usage; exit 1
fi
if [[ $REGISTRY_MODE -eq 1 ]]; then
    if [[ "$REGISTRY_INFO" =~ ^https?:// ]]; then
        echo "Error: registry must be <host:port> with no http:// or https:// scheme." >&2; exit 1
    fi
    REG_FQDN="${REGISTRY_INFO%%:*}"
    REG_PORT="${REGISTRY_INFO##*:}"
    if [[ "$REG_FQDN" == "$REGISTRY_INFO" || -z "$REG_PORT" ]]; then
        echo "Error: registry must include a port, e.g. harbor.example.com:443." >&2; exit 1
    fi
    if ! [[ "$REG_FQDN" =~ $FQDN_PATTERN || "$REG_FQDN" =~ $IPV4_PATTERN ]]; then
        echo "Error: '$REG_FQDN' is not a valid FQDN or IPv4 address." >&2; exit 1
    fi
    if ! [[ "$REG_PORT" =~ ^[0-9]+$ ]] || (( REG_PORT < 1 || REG_PORT > 65535 )); then
        echo "Error: registry port '$REG_PORT' must be between 1 and 65535." >&2; exit 1
    fi
    if [[ -z "$REG_USER" || -z "$REG_PASS" ]]; then
        echo "Error: registry username and password are required (REG_USER / REG_PASS)." >&2; exit 1
    fi
fi
# push / -registry only apply to install (and push to save). Pull-only (-registry
# without push) is meaningless for save, which builds a bundle rather than deploying.
case "$CMD" in
    install) : ;;
    save)
        if [[ $REGISTRY_MODE -eq 1 && $PUSH_MODE -eq 0 ]]; then
            echo "Error: 'save' supports 'push -registry ...' but not -registry alone (save builds a bundle, it does not pull-and-run)." >&2
            exit 1
        fi ;;
    *)
        if [[ $PUSH_MODE -eq 1 || $REGISTRY_MODE -eq 1 ]]; then
            echo "Error: push/-registry are only valid with 'install' (and 'save push')." >&2
            exit 1
        fi ;;
esac

### ---- Dispatch ----
require_root
case "$CMD" in
    install)   do_install ;;
    save)      do_save ;;
    uninstall) do_uninstall ;;
    status)    do_status ;;
    *) echo "Unknown command: $CMD" >&2; echo; usage; exit 1 ;;
esac
