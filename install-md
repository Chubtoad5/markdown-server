// ---- Organize sidebar order (per-folder .order manifest) ----
let orderFolder = '';   // relative folder path being edited ('' = root)
let orderItems = [];    // [{name, isDir}] in current (editable) order
function escapeHtml(s){ return s.replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function byteCmp(a,b){ return a<b?-1:a>b?1:0; }   // mirror the server's sortAlpha (byte order)
async function loadOrder(){
  const f = document.getElementById('orderDir').value.trim().replace(/^\/+|\/+$/g,'');
  if(f && folderDepth(f) > MAX_DEPTH){ show('Folder too deep (max '+MAX_DEPTH+' levels)', false); return; }
  // 1. List direct children via WebDAV PROPFIND (Depth 1).
  const url = davUrl(f ? f+'/' : '');
  let resp;
  try{ resp = await fetch(url, {method:'PROPFIND', headers:{'Depth':'1'}}); }
  catch(e){ show('Could not list folder: '+e, false); return; }
  if(!resp.ok){ show('Could not list '+(f||'(root)')+(resp.status===404?' — folder not found':' ('+resp.status+')'), false); return; }
  const xml = new DOMParser().parseFromString(await resp.text(), 'application/xml');
  const items = [];
  for(const r of xml.getElementsByTagNameNS('DAV:','response')){
    const hrefEl = r.getElementsByTagNameNS('DAV:','href')[0];
    if(!hrefEl) continue;
    // hrefs come back rooted at the WebDAV root WITHOUT the /dav route prefix (it is
    // stripped before webdav), and may be absolute. Normalise to a path relative to the
    // content root so we can reliably skip the self entry (PROPFIND Depth 1 returns the
    // folder itself plus its direct children).
    let rel = decodeURIComponent(hrefEl.textContent.trim())
      .replace(/^https?:\/\/[^/]+/, '')   // drop scheme://host if absolute
      .replace(/^\/dav(?=\/|$)/, '')       // drop optional /dav prefix
      .replace(/^\/+|\/+$/g, '');          // trim leading/trailing slashes
    if(rel === f) continue;                                // the folder itself
    const name = rel.split('/').pop();
    if(!name || name.startsWith('.')) continue;            // dotfiles (.order, .admin.html, ...)
    const isDir = r.getElementsByTagNameNS('DAV:','collection').length > 0;
    if(isDir){ if(name.indexOf('.') >= 0) continue; }       // sidebar shows dotless folders only
    else { if(!name.endsWith('.md')) continue; }            // and .md files
    if(f === '' && name === 'index.md') continue;           // root index.md is the fixed "Home" link
    items.push({name, isDir});
  }
  // 2. Merge with any existing .order, mirroring the server's render rule.
  let manifest = [];
  try{
    const mr = await fetch('/raw/' + (f ? f+'/' : '') + '.order', {cache:'no-store'});
    if(mr.ok){ manifest = (await mr.text()).split('\n').map(s=>s.trim()).filter(Boolean); }
  }catch(e){}
  const byName = new Map(items.map(it=>[it.name, it]));
  const seen = new Set();
  const ordered = [];
  for(const n of manifest){ if(byName.has(n) && !seen.has(n)){ ordered.push(byName.get(n)); seen.add(n); } }
  let leftovers = items.filter(it=>!seen.has(it.name)).sort((a,b)=>byteCmp(a.name,b.name));
  if(manifest.length === 0){    // no manifest: pin index.md / README.md to the top
    const pinned = [];
    for(const pn of ['index.md','README.md']){
      const i = leftovers.findIndex(it=>it.name===pn);
      if(i >= 0){ pinned.push(leftovers[i]); leftovers.splice(i,1); }
    }
    leftovers = pinned.concat(leftovers);
  }
  orderItems = ordered.concat(leftovers);
  orderFolder = f;
